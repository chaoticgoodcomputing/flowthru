{
  "name": "Flowthru.Integrations.MLNet",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "src/Flowthru.Integrations.MLNet",
  "targets": {
    "build": {
      "executor": "@nx-dotnet/core:build",
      "outputs": [ "{workspaceRoot}/dist/bin/{projectRoot}" ],
      "options": {
        "configuration": "Debug",
        "noDependencies": true
      },
      "configurations": {
        "production": {
          "configuration": "Release"
        }
      }
    },
    "lint": {
      "executor": "@nx-dotnet/core:format",
      "options": {
        "verify": true,
        "noRestore": true
      }
    },
    "test": {
      "executor": "@nx-dotnet/core:test",
      "outputs": [ "{workspaceRoot}/coverage/{projectRoot}" ],
      "options": {
        "configuration": "Debug",
        "noBuild": false
      }
    }
  },
  "tags": [ "type:library", "scope:integrations", "framework:ml" ]
}
