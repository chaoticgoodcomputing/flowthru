<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Flowthru's FP foundations — temporary parallel package for the FP rewrite. Renamed to Flowthru.Core when the rewrite completes.</Description>

    <!-- NuGet Package Configuration -->
    <PackageId>Flowthru.New.Core</PackageId>
    <PackageTags>data-engineering;pipeline;functional-programming</PackageTags>

    <!--
      CS1591 (missing XML comment) is suppressed during the rewrite. The bulk
      of warnings are on auto-generated record members where the type-level
      doc comment already explains the case. A full doc pass happens in
      Phase 3 of the FP rewrite.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Global usings: Flowthru.Prelude is implicitly imported, mirroring Haskell's
    implicit Prelude. The same import is propagated to NuGet consumers via the
    build/ props file below.
  -->
  <ItemGroup>
    <Using Include="Flowthru.Prelude" />
    <Using Include="Flowthru.Error" />
    <Using Include="Flowthru.Validation" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build/Flowthru.New.Core.props" Pack="true" PackagePath="build/" />
  </ItemGroup>

</Project>
