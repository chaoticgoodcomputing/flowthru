<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Flowthru CLI: standalone entry point for running Flowthru flows.</Description>

    <PackageId>Flowthru.Cli</PackageId>
    <PackageTags>data-engineering;pipeline;cli</PackageTags>

    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core/Flowthru.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Flowthru.Prelude" />
    <Using Include="Flowthru.Validation.PreFlight" />
    <Using Include="Flowthru.Validation.Runtime" />
    <Using Include="Flowthru.Step" />
    <Using Include="Flowthru.Flow" />
    <Using Include="Flowthru.Diagnostics" />
    <Using Include="Flowthru.Hosting" />
  </ItemGroup>

</Project>
