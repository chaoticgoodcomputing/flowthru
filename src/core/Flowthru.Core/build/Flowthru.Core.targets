<Project>
  <!-- 
    Auto-imported MSBuild targets for Flowthru.
    Registers source generators for consuming projects.
  -->
  
  <!-- 
    Auto-register Flowthru source generators for any consuming project.
    This ensures generators work in both development (ProjectReference) and 
    distribution (NuGet package) scenarios.
  -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\Flowthru.Core.SourceGenerators\Flowthru.Core.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      Condition="'$(MSBuildProjectName)' != 'Flowthru.Core' AND Exists('$(MSBuildThisFileDirectory)..\..\Flowthru.Core.SourceGenerators\Flowthru.Core.SourceGenerators.csproj')" />

    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\Flowthru.Core.CodeFixes\Flowthru.Core.CodeFixes.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      Condition="'$(MSBuildProjectName)' != 'Flowthru.Core' AND Exists('$(MSBuildThisFileDirectory)..\..\Flowthru.Core.CodeFixes\Flowthru.Core.CodeFixes.csproj')" />
    
    <!-- For NuGet package consumption -->
    <Analyzer Include="$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Flowthru.Core.SourceGenerators.dll" 
              Condition="Exists('$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Flowthru.Core.SourceGenerators.dll')" />
    <Analyzer Include="$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Flowthru.Core.CodeFixes.dll" 
              Condition="Exists('$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Flowthru.Core.CodeFixes.dll')" />
  </ItemGroup>

</Project>
