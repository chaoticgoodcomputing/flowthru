<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Flowthru core library: data, effect, validation, step, flow, diagnostics, and hosting algebras for the Flowthru data pipeline framework.</Description>

    <PackageId>Flowthru.Core</PackageId>
    <PackageTags>data-engineering;pipeline;functional-programming</PackageTags>

    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Expose `internal` members to the unit-test assembly. The
       InspectionResult.Internal property is intentionally internal at the
       public API surface (users see only the opaque struct + Inspect helpers)
       but the dispatcher pipeline + tests need to inspect the wrapped
       Validated value. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Flowthru.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Flowthru.Prelude" />
    <Using Include="Flowthru.Validation.PreFlight" />
    <Using Include="Flowthru.Validation.Runtime" />
    <Using Include="Flowthru.Step" />
    <Using Include="Flowthru.Flow" />
    <Using Include="Flowthru.Diagnostics" />
  </ItemGroup>

  <!--
    Wire the source generators as analyzers on Flowthru.Core itself, so
    [FlowthruSchema]-attributed types declared inside Core get marker
    interfaces emitted at compile time.
  -->
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core.SourceGenerators/Flowthru.Core.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core.CodeFixes/Flowthru.Core.CodeFixes.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <!--
    Pack the analyzer DLLs into the conventional analyzers/dotnet/cs/ slot and
    ship build/Flowthru.Core.targets so NuGet consumers auto-register them.
    Without this block, [FlowthruSchema]-annotated types in downstream
    projects fail CS0311 because the marker-interface generator never runs.
  -->
  <ItemGroup>
    <None Include="$(RepoRoot)dist/src/core/Flowthru.Core.SourceGenerators/$(Configuration)/netstandard2.0/Flowthru.Core.SourceGenerators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="$(RepoRoot)dist/src/core/Flowthru.Core.CodeFixes/$(Configuration)/netstandard2.0/Flowthru.Core.CodeFixes.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="build/Flowthru.Core.targets" Pack="true" PackagePath="build/" />
  </ItemGroup>

  <Target Name="EnsureAnalyzerDllsBuilt" BeforeTargets="GenerateNuspec" Condition="'$(NoBuild)' != 'true'">
    <MSBuild Projects="$(RepoRoot)src/core/Flowthru.Core.SourceGenerators/Flowthru.Core.SourceGenerators.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(RepoRoot)src/core/Flowthru.Core.CodeFixes/Flowthru.Core.CodeFixes.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
