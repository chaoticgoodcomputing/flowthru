<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>A type-safe data engineering framework for .NET</Description>
    
    <!-- NuGet Package Configuration -->
    <PackageId>Flowthru.Core</PackageId>
    <PackageTags>data-engineering;pipeline;kedro</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Version inherited from Directory.Build.props -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flowthru.Core.Tests" />
    <!-- Format extension packages need access to internal serialization helpers -->
    <InternalsVisibleTo Include="Flowthru.Extensions.Csv" />
    <InternalsVisibleTo Include="Flowthru.Extensions.Parquet" />
    <InternalsVisibleTo Include="Flowthru.Extensions.Excel" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dependency Injection Abstractions (no concrete container) -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.10" />
    
    <!-- Logging Abstractions (Serilog compatible) -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.10" />
    
    <!-- Configuration Support -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.10" />
    
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.10" />
    
    <!-- Data Annotations for validation -->
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <!-- Reference own source generator for self-generation -->
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core.SourceGenerators/Flowthru.Core.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include README and LICENSE in package -->
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="$(RepoRoot)LICENSE" Pack="true" PackagePath="/" />
    <!-- Include build props to auto-import source generators -->
    <None Include="build/Flowthru.Core.props" Pack="true" PackagePath="build/" />
  </ItemGroup>

  <!-- Package source generators and code fixes in standard analyzer location -->
  <ItemGroup>
    <None Include="$(RepoRoot)dist/src/core/Flowthru.Core.SourceGenerators/$(Configuration)/netstandard2.0/Flowthru.Core.SourceGenerators.dll" 
          Pack="true" 
          PackagePath="analyzers/dotnet/cs" 
          Visible="false" />
    <None Include="$(RepoRoot)dist/src/core/Flowthru.Core.CodeFixes/$(Configuration)/netstandard2.0/Flowthru.Core.CodeFixes.dll" 
          Pack="true" 
          PackagePath="analyzers/dotnet/cs" 
          Visible="false" />
  </ItemGroup>

  <!-- Ensure source generators and code fixes are built before packing -->
  <Target Name="EnsureAnalyzerDllsBuilt" BeforeTargets="GenerateNuspec" Condition="'$(NoBuild)' != 'true'">
    <MSBuild Projects="$(RepoRoot)src/core/Flowthru.Core.SourceGenerators/Flowthru.Core.SourceGenerators.csproj" 
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(RepoRoot)src/core/Flowthru.Core.CodeFixes/Flowthru.Core.CodeFixes.csproj" 
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <!-- Include templates in package -->
  <!-- NoDefaultExcludes allows dotfiles (.gitignore, .gitkeep, etc.) to be packed -->
  <PropertyGroup>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- MSBuild targets file for auto-registering source generators -->
    <None Include="build\Flowthru.Core.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

</Project>
