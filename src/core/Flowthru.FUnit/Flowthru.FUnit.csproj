<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Inline step-test framework for Flowthru pipelines</Description>
    <PackageId>Flowthru.FUnit</PackageId>
    <PackageTags>data-engineering;pipeline;testing;step-tests</PackageTags>
    <NoDefaultExcludes>true</NoDefaultExcludes>

    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core/Flowthru.Core.csproj" />
  </ItemGroup>

  <!-- Wire FUnit's own source generators / analyzers / code-fixes onto FUnit consumers. -->
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.FUnit.SourceGenerators/Flowthru.FUnit.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.FUnit.CodeFixes/Flowthru.FUnit.CodeFixes.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <!--
    Pack the analyzer DLLs into the conventional analyzers/dotnet/cs/ slot and
    ship build/Flowthru.FUnit.targets so consumers auto-register them.
    Mirrors the Flowthru.Core packaging.
  -->
  <ItemGroup>
    <None Include="$(RepoRoot)dist/src/core/Flowthru.FUnit.SourceGenerators/$(Configuration)/netstandard2.0/Flowthru.FUnit.SourceGenerators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="$(RepoRoot)dist/src/core/Flowthru.FUnit.CodeFixes/$(Configuration)/netstandard2.0/Flowthru.FUnit.CodeFixes.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="build/Flowthru.FUnit.targets" Pack="true" PackagePath="build/" />
  </ItemGroup>

  <Target Name="EnsureAnalyzerDllsBuilt" BeforeTargets="GenerateNuspec" Condition="'$(NoBuild)' != 'true'">
    <MSBuild Projects="$(RepoRoot)src/core/Flowthru.FUnit.SourceGenerators/Flowthru.FUnit.SourceGenerators.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(RepoRoot)src/core/Flowthru.FUnit.CodeFixes/Flowthru.FUnit.CodeFixes.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
