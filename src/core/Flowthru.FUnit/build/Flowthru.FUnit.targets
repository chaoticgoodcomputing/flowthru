<Project>
  <!--
    Auto-imported MSBuild targets for Flowthru.FUnit.
    Registers FUnit source generators and code fixes for consuming projects.
  -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\Flowthru.FUnit.SourceGenerators\Flowthru.FUnit.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      Condition="'$(MSBuildProjectName)' != 'Flowthru.FUnit' AND Exists('$(MSBuildThisFileDirectory)..\..\Flowthru.FUnit.SourceGenerators\Flowthru.FUnit.SourceGenerators.csproj')" />

    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\Flowthru.FUnit.CodeFixes\Flowthru.FUnit.CodeFixes.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      Condition="'$(MSBuildProjectName)' != 'Flowthru.FUnit' AND Exists('$(MSBuildThisFileDirectory)..\..\Flowthru.FUnit.CodeFixes\Flowthru.FUnit.CodeFixes.csproj')" />

    <!-- For NuGet package consumption -->
    <Analyzer Include="$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Flowthru.FUnit.SourceGenerators.dll"
              Condition="Exists('$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Flowthru.FUnit.SourceGenerators.dll')" />
    <Analyzer Include="$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Flowthru.FUnit.CodeFixes.dll"
              Condition="Exists('$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Flowthru.FUnit.CodeFixes.dll')" />
  </ItemGroup>

</Project>
