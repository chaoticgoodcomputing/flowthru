{
  "name": "Flowthru.Core.CodeFixes",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [ "nuget" ],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [ "dotnet csharpier {projectRoot}" ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [ "dotnet csharpier {projectRoot} --check" ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
