<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>A type-safe data engineering framework for .NET. Includes CSV, Parquet, and Excel format support.</Description>

    <!-- NuGet Package Configuration -->
    <PackageId>Flowthru</PackageId>
    <PackageTags>data-engineering;pipeline;kedro</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Suppress empty-assembly warnings for meta-package pattern -->
    <NoWarn>$(NoWarn);NU5127;NU5128</NoWarn>
    <!-- NoDefaultExcludes allows dotfiles in packed content -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Meta-package: pulls in core, built-in format extensions, and metadata providers -->
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core/Flowthru.Core.csproj" />
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Csv/Flowthru.Extensions.Csv.csproj" />
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Parquet/Flowthru.Extensions.Parquet.csproj" />
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Excel/Flowthru.Extensions.Excel.csproj" />
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Metadata.Json/Flowthru.Extensions.Metadata.Json.csproj" />
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Metadata.Mermaid/Flowthru.Extensions.Metadata.Mermaid.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include README and LICENSE in package -->
    <None Include="$(RepoRoot)src/core/Flowthru.Core/README.md" Pack="true" PackagePath="/" />
    <None Include="$(RepoRoot)LICENSE" Pack="true" PackagePath="/" />
    <!-- build/ targets for from-source dev experience -->
    <None Include="build/Flowthru.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(RepoRoot)examples/starter/**/*"
             Exclude="$(RepoRoot)examples/starter/**/bin/**;$(RepoRoot)examples/starter/**/obj/**;$(RepoRoot)examples/starter/**/.vs/**;$(RepoRoot)examples/starter/**/.vscode/**;$(RepoRoot)examples/starter/**/*.user;$(RepoRoot)examples/starter/**/.venv/**;$(RepoRoot)examples/starter/**/__pycache__/**"
             Pack="true"
             PackagePath="content/" />
    <Content Include="$(RepoRoot)examples/item-templates/**/*"
             Exclude="$(RepoRoot)examples/item-templates/**/bin/**;$(RepoRoot)examples/item-templates/**/obj/**;$(RepoRoot)examples/item-templates/**/.vs/**;$(RepoRoot)examples/item-templates/**/.vscode/**;$(RepoRoot)examples/item-templates/**/*.user"
             Pack="true"
             PackagePath="content/" />
  </ItemGroup>


</Project>
