<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>A type-safe data engineering framework for .NET. Includes CSV, Parquet, and Excel format support.</Description>

    <!-- NuGet Package Configuration -->
    <PackageId>Flowthru</PackageId>
    <PackageTags>data-engineering;pipeline;kedro</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Suppress empty-assembly warnings for meta-package pattern -->
    <NoWarn>$(NoWarn);NU5127;NU5128</NoWarn>
    <!-- NoDefaultExcludes allows dotfiles in packed content -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Meta-package: pulls in core and all built-in format extensions -->
    <ProjectReference Include="../Flowthru.Core/Flowthru.Core.csproj" />
    <ProjectReference Include="../../extensions/Flowthru.Extensions.Csv/Flowthru.Extensions.Csv.csproj" />
    <ProjectReference Include="../../extensions/Flowthru.Extensions.Parquet/Flowthru.Extensions.Parquet.csproj" />
    <ProjectReference Include="../../extensions/Flowthru.Extensions.Excel/Flowthru.Extensions.Excel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include README and LICENSE in package -->
    <None Include="../Flowthru.Core/README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
    <!-- build/ targets for from-source dev experience -->
    <None Include="build/Flowthru.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../../examples/starter/**/*"
             Exclude="../../../examples/starter/**/bin/**;../../../examples/starter/**/obj/**;../../../examples/starter/**/.vs/**;../../../examples/starter/**/.vscode/**;../../../examples/starter/**/*.user;../../../examples/starter/**/.venv/**;../../../examples/starter/**/__pycache__/**"
             Pack="true"
             PackagePath="content/" />
    <Content Include="../../../examples/item-templates/**/*"
             Exclude="../../../examples/item-templates/**/bin/**;../../../examples/item-templates/**/obj/**;../../../examples/item-templates/**/.vs/**;../../../examples/item-templates/**/.vscode/**;../../../examples/item-templates/**/*.user"
             Pack="true"
             PackagePath="content/" />
  </ItemGroup>


</Project>
