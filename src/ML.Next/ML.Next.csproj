<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ML.Next</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Flowthru Contributors</Authors>
    <Description>Type-safe, functional facade for ML.NET's Extract, Transform, Load capabilities using LanguageExt</Description>
    <PackageTags>mlnet;machine-learning;functional-programming;type-safety;languageext</PackageTags>
    <RepositoryUrl>https://github.com/chaoticgoodcomputing/flowthru</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- LanguageExt for functional programming primitives -->
    
    <!-- ML.NET for machine learning capabilities -->
    <!-- Note: Microsoft.ML includes both Core and Data components -->
    <PackageReference Include="LanguageExt.Core" Version="5.0.0-beta-54" />
    <PackageReference Include="Microsoft.ML" Version="4.0.3" />
  </ItemGroup>

</Project>
