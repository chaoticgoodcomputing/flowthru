<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Flowthru.Extensions.Spark</RootNamespace>
    <Description>Apache Spark integration for Flowthru via typed DataFrame wrappers over Spark.NET</Description>
    <PackageTags>flowthru;spark;apache-spark;dataframe</PackageTags>

    <!-- NuGet Package Configuration -->
    <PackageId>Flowthru.Extensions.Spark</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Flowthru.Extensions.Spark.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../core/Flowthru.Core/Flowthru.Core.csproj" />
    <ProjectReference Include="../../misc/Flowthru.Misc.DataFrames/Flowthru.Misc.DataFrames.csproj" />
    <ProjectReference Include="../../spark/Flowthru.Spark/Flowthru.Spark.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Flowthru.Extensions.Spark.SourceGenerators/Flowthru.Extensions.Spark.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
