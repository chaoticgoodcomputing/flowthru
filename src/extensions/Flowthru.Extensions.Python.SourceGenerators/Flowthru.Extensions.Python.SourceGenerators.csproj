<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>RS2008;RS2007</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Not published standalone; DLL is bundled into Flowthru.Extensions.Python analyzers/dotnet/cs -->
    <IsPackable>false</IsPackable>
    <RootNamespace>Flowthru.Extensions.Python.SourceGenerators</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Shared with the runtime extension: a single canonical list of the CLR-type
       names the Arrow marshaller accepts as leaves. Linked-in here so the
       analyzer and registry cannot drift. -->
  <ItemGroup>
    <Compile Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Python/Step/Python/Internal/PythonMarshallableTypeNames.cs"
             Link="Shared/PythonMarshallableTypeNames.cs" />
  </ItemGroup>

  <!-- Shared with the runtime extension: the requirements algebra
       (ADR-0013). The analyzer (FTPY1501 / FTPY1502) uses the same
       PythonVersion / PythonVersionConstraint / PythonRequirementsAlgebra
       primitives as the pre-flight hook (FTPY3011 / FTPY3012) so design-
       time and runtime enforcement cannot diverge on what "satisfies"
       means. -->
  <ItemGroup>
    <Compile Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Python/Step/Python/PythonPackageRequirement.cs"
             Link="Shared/PythonPackageRequirement.cs" />
    <Compile Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Python/Step/Python/Internal/PythonVersion.cs"
             Link="Shared/PythonVersion.cs" />
    <Compile Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Python/Step/Python/Internal/PythonVersionConstraint.cs"
             Link="Shared/PythonVersionConstraint.cs" />
    <Compile Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Python/Step/Python/Internal/PythonRequirementsAlgebra.cs"
             Link="Shared/PythonRequirementsAlgebra.cs" />
  </ItemGroup>

</Project>
