{
  "name": "Flowthru.Extensions.Python.SourceGenerators",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "Flowthru.Extensions.Python.SourceGenerators",
  "tags": [ "extension", "python", "source-generator" ],
  "targets": {
    "format": {
      "//": "Format C# code using CSharpier",
      "executor": "nx:run-commands",
      "options": {
        "commands": [ "dotnet csharpier {projectRoot}" ],
        "parallel": false
      }
    },
    "format:check": {
      "//": "Check C# code formatting without making changes",
      "executor": "nx:run-commands",
      "options": {
        "commands": [ "dotnet csharpier {projectRoot} --check" ],
        "parallel": false
      }
    }
  }
}
