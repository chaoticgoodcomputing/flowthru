<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>JSON metadata provider for Flowthru pipelines — emits DAG manifests and run results as JSON files.</Description>

    <PackageId>Flowthru.Extensions.Metadata.Json</PackageId>
    <PackageTags>data-engineering;pipeline;metadata;json</PackageTags>

    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core/Flowthru.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
