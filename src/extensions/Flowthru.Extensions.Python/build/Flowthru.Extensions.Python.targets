<!-- 
  Auto-imported MSBuild targets for Flowthru.Extensions.Python.
  Handles .py file propagation, Python environment validation, and source generator registration.
-->
<Project>
  
  <!-- 
    Auto-register Python extension source generators for any consuming project.
    This ensures generators work in both development (ProjectReference) and 
    distribution (NuGet package) scenarios.
    
    Generators only register if this .targets file was explicitly imported by the project
    (either via ProjectReference → manual Import, or via NuGet PackageReference → automatic import).
    This prevents generators from running on projects that don't use Python.
  -->
  <!-- The path is normalized via [System.IO.Path]::GetFullPath so MSBuild's
       ProjectReference dedup matches the Python runtime project's own
       transitive reference to this source generator (which uses
       $(RepoRoot)src/extensions/...). Without normalization, the two
       ProjectReferences carry different Identity strings, MSBuild keeps
       both, and the non-Analyzer one wins at compile time — Roslyn
       silently skips analyzer execution. -->
  <PropertyGroup>
    <_FlowthruPythonSourceGeneratorsCsproj>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\Flowthru.Extensions.Python.SourceGenerators\Flowthru.Extensions.Python.SourceGenerators.csproj'))</_FlowthruPythonSourceGeneratorsCsproj>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Flowthru.Extensions.Python'">
    <!-- For local development with ProjectReference (no-op in NuGet consumption: .csproj file won't exist) -->
    <ProjectReference Include="$(_FlowthruPythonSourceGeneratorsCsproj)"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      Condition="Exists('$(_FlowthruPythonSourceGeneratorsCsproj)')" />
    <!-- NuGet auto-registers DLLs from analyzers/dotnet/cs/ — no explicit <Analyzer> entry needed -->
  </ItemGroup>
  
  <!-- 
    Propagate .py files to output directory and NuGet packages.
    
    CopyToOutputDirectory: Ensures .py files are copied alongside compiled DLLs.
    This preserves the fast iteration loop — editing a .py file and re-running
    does NOT require a C# rebuild.
    
    PackageCopyToOutput: When this project is NuGet-packaged and referenced by
    another project, .py files flow through to the consuming project's output.
    
    Note: Python environment files (pyproject.toml, uv.lock, .python-version) must be
    explicitly copied by the consuming project's .csproj. See example projects for reference.
  -->
  <ItemGroup>
    <!-- User .py files (node implementations) -->
    <Content Include="**\*.py"
             Exclude="bin\**;obj\**;_generated\**;build\**"
             CopyToOutputDirectory="PreserveNewest"
             PackageCopyToOutput="true"
             Visible="false" />

    <!--
      Expose .py files to source generators so PythonStepFactoryGenerator
      can parse @step(...) decorators (Phase 8.0.9 caching opt-in).
      Without this, the generator's AdditionalTextsProvider sees no .py
      files and emits no factory methods or cache registrations.
    -->
    <AdditionalFiles Include="**\*.py"
                     Exclude="bin\**;obj\**;_generated\**;build\**;**\.venv\**"
                     Visible="false" />

    <!--
      Expose uv.lock to PythonRequirementsAnalyzer (FTPY1501 / FTPY1502)
      so it can statically check the project's locked Python deps
      against the algebra closure (base extension requirements + every
      [PythonPackageRequirement]-decorated capability). Condition guards
      against projects that don't use uv. Per ADR-0013.
    -->
    <AdditionalFiles Include="uv.lock"
                     Condition="Exists('uv.lock')"
                     Visible="false" />
    
    <!-- Phase 5: Generated Python schemas -->
    <Content Include="_generated\**\*.py"
             CopyToOutputDirectory="PreserveNewest"
             PackageCopyToOutput="true"
             Visible="false" />
    
    <!-- Internal bridge module (shipped with extension) -->
    <None Include="$(MSBuildThisFileDirectory)_flowthru_arrow.py"
          CopyToOutputDirectory="PreserveNewest"
          PackageCopyToOutput="true"
          Pack="true"
          PackagePath="build"
          Visible="false" />

    <!-- Subprocess worker script (shipped with extension) -->
    <None Include="$(MSBuildThisFileDirectory)flowthru_worker.py"
          CopyToOutputDirectory="PreserveNewest"
          PackageCopyToOutput="true"
          Pack="true"
          PackagePath="build"
          Visible="false" />

    <!-- flowthru Python package (__init__.py, step.py) -->
    <None Include="$(MSBuildThisFileDirectory)flowthru\__init__.py"
          CopyToOutputDirectory="PreserveNewest"
          PackageCopyToOutput="true"
          Pack="true"
          PackagePath="build\flowthru"
          Visible="false"
          Link="flowthru\__init__.py" />
    <None Include="$(MSBuildThisFileDirectory)flowthru\step.py"
          CopyToOutputDirectory="PreserveNewest"
          PackageCopyToOutput="true"
          Pack="true"
          PackagePath="build\flowthru"
          Visible="false"
          Link="flowthru\step.py" />
    <None Include="$(MSBuildThisFileDirectory)flowthru\validation.py"
          CopyToOutputDirectory="PreserveNewest"
          PackageCopyToOutput="true"
          Pack="true"
          PackagePath="build\flowthru"
          Visible="false"
          Link="flowthru\validation.py" />
    <None Include="$(MSBuildThisFileDirectory)flowthru\config.py"
          CopyToOutputDirectory="PreserveNewest"
          PackageCopyToOutput="true"
          Pack="true"
          PackagePath="build\flowthru"
          Visible="false"
          Link="flowthru\config.py" />
  </ItemGroup>

  <!--
    Build-time Python environment validation.
    
    Logs a warning (not error) if no Python environment is auto-detectable.
    This allows container builds where Python is installed at runtime via Dockerfile,
    and PYTHONNET_PYDLL is set as an environment variable after build.
    
    Failures at this stage are advisory, not blocking.
    If pre-flight validation (Phase 4) is enabled, it will catch missing Python at runtime.
  -->
  <Target Name="ValidatePythonEnvironment" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <!-- Check for Python via common conventions -->
      <PythonDllFromEnv>$(PYTHONNET_PYDLL)</PythonDllFromEnv>
      <HasVenvFolder Condition="Exists('.venv')">true</HasVenvFolder>
      
      <!-- Platform-specific system Python probes -->
      <HasSystemPythonWindows Condition="'$(OS)' == 'Windows_NT' AND Exists('C:\Python3')">true</HasSystemPythonWindows>
      <HasSystemPythonUnix Condition="'$(OS)' != 'Windows_NT'">true</HasSystemPythonUnix>
      
      <HasAnyPython Condition="'$(PythonDllFromEnv)' != '' OR '$(HasVenvFolder)' == 'true' OR '$(HasSystemPythonWindows)' == 'true' OR '$(HasSystemPythonUnix)' == 'true'">true</HasAnyPython>
    </PropertyGroup>

    <Warning 
      Condition="'$(HasAnyPython)' != 'true'"
      Text="No Python environment detected. Set PYTHONNET_PYDLL environment variable, ensure Python is installed, or create a .venv/ virtual environment. Python nodes will fail at runtime if no Python is available." />
    
    <Message 
      Condition="'$(HasAnyPython)' == 'true'"
      Text="Python environment detected (auto-detection passed)"
      Importance="low" />
  </Target>

  <!--
    Phase 5: Export Python schemas from C# schema manifest.
    
    Runs after compilation to read the SchemaManifest generated by
    SchemaInterfaceGenerator and emit corresponding .py files to
    _generated/flowthru_schemas/.
    
    Output files are automatically propagated via the Content include above.
    
    Skip this target when building Flowthru.Extensions.Python itself (circular dependency).
  -->
  <PropertyGroup>
    <!-- Development: use bin output directory -->
    <FlowthruPythonDllPath Condition="Exists('$(MSBuildThisFileDirectory)..\bin\Debug\net10.0\Flowthru.Extensions.Python.dll')">$(MSBuildThisFileDirectory)..\bin\Debug\net10.0\Flowthru.Extensions.Python.dll</FlowthruPythonDllPath>
    <FlowthruPythonDllPath Condition="'$(FlowthruPythonDllPath)' == '' AND Exists('$(MSBuildThisFileDirectory)..\bin\Release\net10.0\Flowthru.Extensions.Python.dll')">$(MSBuildThisFileDirectory)..\bin\Release\net10.0\Flowthru.Extensions.Python.dll</FlowthruPythonDllPath>
    <!-- NuGet: use lib directory -->
    <FlowthruPythonDllPath Condition="'$(FlowthruPythonDllPath)' == ''">$(MSBuildThisFileDirectory)..\lib\net10.0\Flowthru.Extensions.Python.dll</FlowthruPythonDllPath>
  </PropertyGroup>

  <!-- Only declare UsingTask if the DLL exists to avoid errors during library's own build -->
  <UsingTask 
    TaskName="Flowthru.Extensions.Python.Build.PythonSchemaExportTask"
    AssemblyFile="$(FlowthruPythonDllPath)"
    Condition="Exists('$(FlowthruPythonDllPath)')" />

  <Target Name="ExportPythonSchemas" 
          AfterTargets="Build"
          Condition="Exists('$(FlowthruPythonDllPath)')">
    <PropertyGroup>
      <PythonSchemaOutputDir>$(ProjectDir)_generated\flowthru_schemas</PythonSchemaOutputDir>
    </PropertyGroup>

    <PythonSchemaExportTask 
      AssemblyPath="$(TargetPath)"
      OutputDirectory="$(PythonSchemaOutputDir)" />
  </Target>

  <!--
    Opt-in build-time Python environment synchronization.
    
    Set FlowthruSyncPythonOnBuild=true in your project to run "uv sync" with the frozen flag
    during build, creating .venv/ in the output directory before runtime.
    
    This is useful for CI/CD pipelines where first-run startup latency matters.
    For local development, runtime sync (on-demand) is typically sufficient.
    
    Example usage in .csproj:
      <PropertyGroup>
        <FlowthruSyncPythonOnBuild>true</FlowthruSyncPythonOnBuild>
        <FlowthruUvPath Condition="'$(FlowthruUvPath)' == ''">uv</FlowthruUvPath>
      </PropertyGroup>
  -->
  <Target Name="SyncPythonEnvironment" 
          AfterTargets="Build"
          Condition="'$(FlowthruSyncPythonOnBuild)' == 'true' AND Exists('$(OutDir)pyproject.toml') AND Exists('$(OutDir)uv.lock')">
    <PropertyGroup>
      <FlowthruUvPath Condition="'$(FlowthruUvPath)' == ''">uv</FlowthruUvPath>
    </PropertyGroup>

    <Message 
      Text="Running uv sync in output directory: $(OutDir)"
      Importance="high" />

    <Exec 
      Command="$(FlowthruUvPath) sync --frozen --python-preference only-managed"
      WorkingDirectory="$(OutDir)"
      IgnoreExitCode="false" />

    <Message 
      Text="Python virtual environment created at $(OutDir).venv"
      Importance="high" />
  </Target>

</Project>
