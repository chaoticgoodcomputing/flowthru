<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Python step integration for Flowthru data pipelines</Description>

    <!-- NuGet Package Configuration -->
    <PackageId>Flowthru.Extensions.Python</PackageId>
    <PackageTags>data-engineering;pipeline;python</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core/Flowthru.Core.csproj" />

    <!-- Source generator (isolated from runtime dependencies) -->
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Python.SourceGenerators/Flowthru.Extensions.Python.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Apache Arrow — tabular data interchange wire format with the subprocess worker -->
    <PackageReference Include="Apache.Arrow" />

    <!-- MSBuild task authoring (PythonSchemaExportTask) -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" />

    <!-- DI / config / logging surface — UsePython() and the runtime options bind here -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flowthru.Extensions.Python.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- MSBuild targets file shipped to consumers -->
    <None Include="build\Flowthru.Extensions.Python.targets" Pack="true" PackagePath="build\" />

    <!-- Arrow IPC bridge module -->
    <Content Include="build\_flowthru_arrow.py"
             CopyToOutputDirectory="PreserveNewest"
             Link="_flowthru_arrow.py"
             Pack="true"
             PackagePath="build\" />

    <!-- Subprocess worker script -->
    <Content Include="build\flowthru_worker.py"
             CopyToOutputDirectory="PreserveNewest"
             Link="flowthru_worker.py"
             Pack="true"
             PackagePath="build\" />

    <!-- flowthru Python package (decorator + helpers) -->
    <Content Include="build\flowthru\__init__.py"
             CopyToOutputDirectory="PreserveNewest"
             Link="flowthru\__init__.py"
             Pack="true"
             PackagePath="build\flowthru\" />
    <Content Include="build\flowthru\step.py"
             CopyToOutputDirectory="PreserveNewest"
             Link="flowthru\step.py"
             Pack="true"
             PackagePath="build\flowthru\" />
    <Content Include="build\flowthru\validation.py"
             CopyToOutputDirectory="PreserveNewest"
             Link="flowthru\validation.py"
             Pack="true"
             PackagePath="build\flowthru\" />
    <Content Include="build\flowthru\config.py"
             CopyToOutputDirectory="PreserveNewest"
             Link="flowthru\config.py"
             Pack="true"
             PackagePath="build\flowthru\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle Flowthru.Core.dll alongside the MSBuild task DLL so the
         PythonSchemaExportTask loader can resolve it as a peer assembly
         when consumers import the package. $(OutDir) already includes
         the TFM segment. -->
    <None Include="$(OutDir)Flowthru.Core.dll"
          Pack="true"
          PackagePath="build\"
          Visible="false" />
    <None Include="$(OutDir)Flowthru.Core.dll"
          Pack="true"
          PackagePath="lib\net10.0\"
          Visible="false" />
  </ItemGroup>

  <!-- Package source generators in standard analyzer location -->
  <ItemGroup>
    <None Include="$(RepoRoot)dist/src/extensions/Flowthru.Extensions.Python.SourceGenerators/$(Configuration)/netstandard2.0/Flowthru.Extensions.Python.SourceGenerators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
