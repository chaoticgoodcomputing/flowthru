<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Flowthru</RootNamespace>
    <Description>CSV format support for Flowthru data catalogs</Description>

    <!-- NuGet Package Configuration -->
    <PackageId>Flowthru.Extensions.Csv</PackageId>
    <PackageTags>data-engineering;pipeline;csv</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Flowthru library -->
    <ProjectReference Include="../../core/Flowthru.Core/Flowthru.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="30.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include README and LICENSE in package -->
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
