<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>XML document support for Flowthru data catalogs (singleton + directory-of-singletons via System.Xml.Serialization).</Description>

    <PackageId>Flowthru.Extensions.Xml</PackageId>
    <PackageTags>data-engineering;pipeline;xml</PackageTags>

    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core/Flowthru.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
