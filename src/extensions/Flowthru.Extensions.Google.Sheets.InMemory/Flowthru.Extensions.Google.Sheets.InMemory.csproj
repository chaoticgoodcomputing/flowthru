<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Offline, JSON-backed in-memory ISheetsGateway for Flowthru — fixtures the Google Sheets extension's example and tests with zero Google dependency</Description>

    <!-- NuGet Package Configuration -->
    <PackageId>Flowthru.Extensions.Google.Sheets.InMemory</PackageId>
    <PackageTags>data-engineering;pipeline;google-sheets;sheets;in-memory;testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!--
      References the main extension for ISheetsGateway and the neutral tabular
      types only. Deliberately NO Google.Apis.* reference — zero Google
      dependency is the whole point (the Microsoft.EntityFrameworkCore.InMemory
      precedent). TimeProvider is in the BCL on net10, so no extra package.
    -->
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Google.Sheets/Flowthru.Extensions.Google.Sheets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flowthru.Extensions.Google.Sheets.InMemory.Tests" />
  </ItemGroup>

</Project>
