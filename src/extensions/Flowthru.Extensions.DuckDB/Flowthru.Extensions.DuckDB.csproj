<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>DuckDB engine-delegated wide transforms for Flowthru flows — SQL over Parquet catalog items, executed entirely inside the embedded engine.</Description>

    <PackageId>Flowthru.Extensions.DuckDB</PackageId>
    <PackageTags>data-engineering;pipeline;duckdb;sql;parquet;olap</PackageTags>

    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core/Flowthru.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded DuckDB — managed ADO.NET provider plus native engine binaries -->
    <PackageReference Include="DuckDB.NET.Data.Full" />

    <!-- DI / config surface — UseDuckDb() and the engine options bind here -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flowthru.Extensions.DuckDB.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
