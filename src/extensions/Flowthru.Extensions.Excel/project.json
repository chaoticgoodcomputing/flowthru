{
  "name": "Flowthru.Extensions.Excel",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "Flowthru.Extensions.Excel",
  "tags": [ ],
  "// targets": "to see all targets run: nx show project Flowthru.Extensions.Excel --web",
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [ "dotnet csharpier {projectRoot}" ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [ "dotnet csharpier {projectRoot} --check" ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
