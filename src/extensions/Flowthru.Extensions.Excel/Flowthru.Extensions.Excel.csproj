<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Flowthru</RootNamespace>
    <Description>Excel format support for Flowthru data catalogs</Description>

    <!-- NuGet Package Configuration -->
    <PackageId>Flowthru.Extensions.Excel</PackageId>
    <PackageTags>data-engineering;pipeline;excel;xlsx</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Flowthru library -->
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core/Flowthru.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.6.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include README and LICENSE in package -->
    <None Include="$(RepoRoot)LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
