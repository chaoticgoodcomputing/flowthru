<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Flowthru.Extensions.EFCore.Bulk</RootNamespace>
    <Description>Bulk operation support for Flowthru EFCore catalog items via EFCore.BulkExtensions</Description>
    
    <!-- NuGet Package Configuration -->
    <PackageId>Flowthru.Extensions.EFCore.Bulk</PackageId>
    <PackageTags>data-engineering;pipeline;entity-framework;efcore;database;bulk;bulk-insert</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flowthru.Extensions.EFCore.Bulk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Flowthru EFCore extension (brings in Flowthru.Core transitively) -->
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.EFCore/Flowthru.Extensions.EFCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bulk operations engine -->
    <PackageReference Include="EFCore.BulkExtensions" />
  </ItemGroup>

</Project>
