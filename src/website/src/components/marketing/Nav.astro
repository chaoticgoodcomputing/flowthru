---
import BrandMark from "./BrandMark.astro";

const docsBase = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (p: string) => `${docsBase}${p}`;
---

<header class="nav">
  <a class="brand" href={href("/")}>
    <BrandMark />
    Flowthru
  </a>
  <nav class="nav-links">
    <a href={href("/docs/")}>Docs</a>
    <a href={href("/docs/tutorials/spaceflights/")}>Examples</a>
    <a href="#extensions">Extensions</a>
    <a href="https://github.com/chaoticgoodcomputing/flowthru/blob/main/CHANGELOG.md">Changelog</a>
    <a href="https://github.com/chaoticgoodcomputing/flowthru">GitHub ↗</a>
  </nav>
  <a class="cta" href={href("/docs/tutorials/spaceflights/")}>
    Build your first Flow
  </a>
</header>
