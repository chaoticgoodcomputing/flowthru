---
// Flowthru marketing homepage. Standalone Astro page (not Starlight). Lives at
// the site root; docs are namespaced under /docs/* via Starlight. Composed
// from components under src/components/marketing/.
import "../styles/marketing.css";
import Nav from "../components/marketing/Nav.astro";
import Hero from "../components/marketing/Hero.astro";
import Anatomy from "../components/marketing/Anatomy.astro";
import ErrorSurface from "../components/marketing/ErrorSurface.astro";
import Extensions from "../components/marketing/Extensions.astro";
import DocsThreePlaces from "../components/marketing/DocsThreePlaces.astro";
import InstallCard from "../components/marketing/InstallCard.astro";
import Footer from "../components/marketing/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Flowthru — type-safe data engineering for .NET</title>
    <meta
      name="description"
      content="A type-safe, fail-fast data engineering framework for .NET. Write production-ready data workflows step-by-step, rapidly iterate, and deploy them with confidence."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <Hero />
    <Anatomy />
    <ErrorSurface />
    <Extensions />
    <DocsThreePlaces />
    <InstallCard />
    <Footer />
  </body>
</html>
