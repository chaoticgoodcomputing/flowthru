<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Flowthru.Extensions.ML</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Flowthru Contributors</Authors>
    <Description>Pure, unoptimized UMAP implementation for Flowthru - direct port from Python reference implementation by Leland McInnes</Description>
    <PackageTags>flowthru;machine-learning;umap;dimensionality-reduction;pure</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- ML.NET Core packages -->
    <PackageReference Include="Microsoft.ML" Version="3.0.1" />
    <PackageReference Include="Microsoft.ML.DataView" Version="3.0.1" />
    
    <!-- MathNet for advanced numerical operations (matrix ops, linear algebra) -->
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Flowthru/Flowthru.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="UMAP/UMAP_LICENSE.txt" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
