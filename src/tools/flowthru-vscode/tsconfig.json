{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [ "ES2022" ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "out",
    "rootDir": ".",
    "sourceMap": true,
    "types": [ "node" ]
  },
  "include": [ "src/**/*", "tests/**/*" ],
  "exclude": [ "node_modules", "out", "*.vsix" ]
}
