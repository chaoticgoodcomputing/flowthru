{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": [
    "@nx/dotnet"
  ],
  "targetDefaults": {
    "build": {
      "dependsOn": [ "restore", "^build" ]
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.Tests/**/*",
      "!{projectRoot}/**/bin/**/*",
      "!{projectRoot}/**/obj/**/*"
    ]
  },
  "release": {
    "projects": [
      "flowthru"
    ],
    "projectsRelationship": "fixed",
    "version": {
      "conventionalCommits": true
    },
    "conventionalCommits": {
      "types": {
        "feat": {
          "semverBump": "minor",
          "changelog": {
            "hidden": false
          }
        },
        "fix": {
          "semverBump": "patch",
          "changelog": {
            "hidden": false
          }
        },
        "perf": {
          "semverBump": "patch",
          "changelog": {
            "hidden": false
          }
        },
        "revert": {
          "semverBump": "patch",
          "changelog": {
            "hidden": false
          }
        },
        "docs": false,
        "style": false,
        "chore": false,
        "refactor": false,
        "test": false,
        "build": false,
        "ci": false
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "file": "CHANGELOG.md",
        "createRelease": "github"
      },
      "projectChangelogs": false
    }
  },
  "analytics": false
}
