{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": [
    {
      "plugin": "@nx/dotnet",
      "options": {
        "restore": false
      }
    }
  ],
  "targetDefaults": {
    "build": {
      "dependsOn": [ "^build" ],
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}",
        "{workspaceRoot}/dist/intermediates/{projectRoot}/obj"
      ]
    },
    "build:release": {
      "dependsOn": [ "^build:release" ],
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}",
        "{workspaceRoot}/dist/intermediates/{projectRoot}/obj"
      ]
    },
    "test": {
      "dependsOn": [ "build" ],
      "inputs": [ "default", "^production", "coverageConfig" ]
    },
    "pack": {
      "dependsOn": [ "build:release", "templates:_inject_template_version", "templates:_inject_agents_md" ]
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/Directory.Build.props",
      "{workspaceRoot}/Directory.Build.targets"
    ],
    "coverageConfig": [
      "{workspaceRoot}/coverlet.runsettings"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.Tests/**/*",
      "!{projectRoot}/**/bin/**/*",
      "!{projectRoot}/**/obj/**/*"
    ]
  },
  "release": {
    "projects": [
      "flowthru"
    ],
    "projectsRelationship": "fixed",
    "version": {
      "conventionalCommits": true
    },
    "conventionalCommits": {
      "types": {
        "feat": {
          "semverBump": "minor",
          "changelog": {
            "hidden": false
          }
        },
        "fix": {
          "semverBump": "patch",
          "changelog": {
            "hidden": false
          }
        },
        "perf": {
          "semverBump": "patch",
          "changelog": {
            "hidden": false
          }
        },
        "revert": {
          "semverBump": "patch",
          "changelog": {
            "hidden": false
          }
        },
        "docs": false,
        "style": false,
        "chore": false,
        "refactor": false,
        "test": false,
        "build": false,
        "ci": false
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "file": "CHANGELOG.md",
        "createRelease": "github"
      },
      "projectChangelogs": false
    }
  },
  "analytics": false
}
