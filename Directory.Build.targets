<!--
  This file is imported late in the build order.
  Use it to override properties and define dependent properties.

  Note: Per-archetype Flowthru reference injection (PackageReference→ProjectReference
  swap, Core/FUnit analyzer wiring, FUnit constants) is NOT handled here. Examples
  declare their dependencies via <FlowthruReference> + Import of the appropriate
  build/FlowthruExecutable.props or build/FlowthruLibrary.props at the repo root.

  This file retains only repo-wide concerns: path properties, in-repo replacements
  for the few test projects that haven't yet migrated to <FlowthruReference>, and
  the central coverage runsettings hook for any IsTestProject.
-->
<Project>
  <PropertyGroup>
    <MSBuildProjectDirRelativePath>$([MSBuild]::MakeRelative($(RepoRoot), $(MSBuildProjectDirectory)))</MSBuildProjectDirRelativePath>
    <NodeModulesRelativePath>$([MSBuild]::MakeRelative($(MSBuildProjectDirectory), $(RepoRoot)))</NodeModulesRelativePath>
  </PropertyGroup>

  <!--
    Test projects under tests/ that haven't yet migrated to <FlowthruReference> still
    consume Flowthru via PackageReference (e.g. Flowthru.Tests.Examples, Flowthru.Tests.Helpers).
    For in-repo builds, swap those PackageReferences for ProjectReferences and import the
    Core analyzer targets so source generators are registered.

    This block is migration-scope only — it should disappear when every project under
    examples/ and tests/ uses <FlowthruReference>.
  -->
  <ItemGroup Condition="$(MSBuildProjectDirRelativePath.StartsWith('tests'))">
    <PackageReference Remove="Flowthru" />
    <PackageReference Remove="Flowthru.FUnit" />
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru/Flowthru.csproj"
                      Condition="'$(MSBuildProjectName)' != 'Flowthru.Tests.Helpers'" />
  </ItemGroup>

  <!-- Import the Flowthru.Core targets to register source generators in tests/ projects.
       This mirrors how the published build/Flowthru.Core.targets is auto-imported when
       the project consumes Flowthru.Core via NuGet. -->
  <Import Project="$(RepoRoot)src/core/Flowthru.Core/build/Flowthru.Core.targets"
          Condition="$(MSBuildProjectDirRelativePath.StartsWith('tests')) AND Exists('$(RepoRoot)src/core/Flowthru.Core/build/Flowthru.Core.targets')" />

  <!-- Same for the FUnit targets in tests/ projects with FUnit in the path. Once the
       remaining FUnit-using test csprojs migrate to importing build/FlowthruFUnit.props,
       this can go away. -->
  <Import Project="$(RepoRoot)src/core/Flowthru.FUnit/build/Flowthru.FUnit.targets"
          Condition="$(MSBuildProjectDirRelativePath.StartsWith('tests')) AND $(MSBuildProjectDirRelativePath.Contains('FUnit')) AND Exists('$(RepoRoot)src/core/Flowthru.FUnit/build/Flowthru.FUnit.targets')" />

  <!--
    Central coverage configuration: any project identified as a test project by
    Microsoft.NET.Test.Sdk automatically uses coverlet.runsettings, regardless of
    how dotnet test is invoked (IDE, CLI, or NX target). This removes the need to
    pass collect and settings flags on every call site.
  -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <RunSettingsFilePath>$(RepoRoot)coverlet.runsettings</RunSettingsFilePath>
  </PropertyGroup>

</Project>
