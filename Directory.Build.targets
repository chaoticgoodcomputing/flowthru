<!-- 
  This file is imported late in the build order. 
  Use it to override properties and define dependent properties.
-->
<Project>
  <PropertyGroup>
    <MSBuildProjectDirRelativePath>$([MSBuild]::MakeRelative($(RepoRoot), $(MSBuildProjectDirectory)))</MSBuildProjectDirRelativePath>
    <NodeModulesRelativePath>$([MSBuild]::MakeRelative($(MSBuildProjectDirectory), $(RepoRoot)))</NodeModulesRelativePath>
  </PropertyGroup>

  <!-- 
    For example and test projects within the repo: replace PackageReferences with ProjectReferences.
    This ensures the test suite always uses local versions while keeping projects as
    true NuGet consumers when distributed.
    
    Exception: Flowthru.Tests.Common needs direct SourceGenerators reference for testing.
  -->
  <ItemGroup Condition="($(MSBuildProjectDirRelativePath.StartsWith('examples')) OR $(MSBuildProjectDirRelativePath.StartsWith('tests'))) AND '$(MSBuildProjectName)' != 'Flowthru.Tests.Common'">
    <!-- Remove Flowthru PackageReferences -->
    <PackageReference Remove="Flowthru" />
    <PackageReference Remove="Flowthru.Extensions.ML" />
    
    <!-- Add Flowthru ProjectReferences -->
    <ProjectReference Include="$(RepoRoot)src\Flowthru\Flowthru.csproj" />
    <ProjectReference Include="$(RepoRoot)src\Flowthru.SourceGenerators\Flowthru.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
    
    <!-- Add Extensions.ML ProjectReference only for UmapReferenceComparisons -->
    <ProjectReference Include="$(RepoRoot)src\Flowthru.Extensions.ML\Flowthru.Extensions.ML.csproj" 
                      Condition="'$(MSBuildProjectName)' == 'UmapReferenceComparisons'" />
  </ItemGroup>

  <!-- Special case for Flowthru.Tests.Common: also convert PackageReference but keep existing SourceGenerators ProjectReference -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Flowthru.Tests.Common'">
    <PackageReference Remove="Flowthru" />
    <ProjectReference Include="$(RepoRoot)src\Flowthru\Flowthru.csproj" />
  </ItemGroup>

</Project>
