<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Flowthru.Tools.CapabilityMatrix</RootNamespace>
    <Description>
      Generates docs/reference/extensions/capability-matrix.md from each format
      extension's IFormatSerializer&lt;TRow&gt;.RowFeatures declaration. Run via
      nx _test:capability-matrix-freshness; the meta-test diffs the regenerated
      output against the committed file.
    </Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core/Flowthru.Core.csproj" />
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Csv/Flowthru.Extensions.Csv.csproj" />
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Excel/Flowthru.Extensions.Excel.csproj" />
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Parquet/Flowthru.Extensions.Parquet.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/helpers/Flowthru.Tests.Kits/Flowthru.Tests.Kits.csproj" />
  </ItemGroup>

</Project>
