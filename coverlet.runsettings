<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Output formats -->
          <Format>cobertura,json,lcov</Format>
          
          <!-- Include patterns: what to measure coverage for -->
          <!-- [Flowthru]* covers all assemblies: Flowthru, Flowthru.Core,
               Flowthru.Extensions.*, Flowthru.FUnit, Flowthru.Misc.* -->
          <Include>
            [Flowthru*]*
          </Include>
          
          <!-- Exclude patterns: what NOT to measure -->
          <Exclude>
            [*.Tests]*
            [*.Tests.*]*
            [xunit.*]*
            [NUnit.*]*
            [Microsoft.*]*
            [System.*]*
          </Exclude>
          
          <!-- Exclude by attribute -->
          <ExcludeByAttribute>
            Obsolete
            GeneratedCodeAttribute
            CompilerGeneratedAttribute
            ExcludeFromCodeCoverageAttribute
          </ExcludeByAttribute>
          
          <!-- Exclude by file pattern -->
          <ExcludeByFile>
            **/Migrations/**/*.cs
            **/obj/**/*.cs
            **/bin/**/*.cs
            **/*Designer.cs
            **/*.g.cs
            **/*.g.i.cs
          </ExcludeByFile>
          
          <!-- Coverage options -->
          <SingleHit>false</SingleHit>
          <UseSourceLink>true</UseSourceLink>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>false</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
