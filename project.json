{
  "name": "flowthru",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": ".",
  "targets": {
    "restore": {
      "//": "Restores .NET dependencies for the solution",
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "dotnet restore Flowthru.slnx"
        ],
        "parallel": false
      }
    },
    "build:release": {
      "//": "Builds the solution in Release configuration",
      "executor": "nx:run-commands",
      "dependsOn": [ "restore" ],
      "options": {
        "commands": [
          "dotnet build Flowthru.slnx --configuration Release --no-restore"
        ],
        "parallel": false
      }
    },
    "test:coverage": {
      "//": "Runs tests with coverage collection",
      "executor": "nx:run-commands",
      "dependsOn": [ "build:release" ],
      "options": {
        "commands": [
          "dotnet test Flowthru.slnx --configuration Release --no-build --collect:\"XPlat Code Coverage\" --settings coverlet.runsettings --logger \"console;verbosity=minimal\""
        ],
        "parallel": false
      }
    },
    "coverage:report": {
      "//": "Generates HTML coverage report from test results",
      "executor": "nx:run-commands",
      "dependsOn": [ "test:coverage" ],
      "options": {
        "commands": [
          "reportgenerator \"-reports:tests/**/TestResults/**/coverage.cobertura.xml\" \"-targetdir:CoverageReport\" \"-reporttypes:Html;Badges\" \"-verbosity:Info\""
        ],
        "parallel": false
      }
    },
    "coverage:badges": {
      "//": "Generates coverage badges for release artifacts",
      "executor": "nx:run-commands",
      "dependsOn": [ "test:coverage" ],
      "options": {
        "commands": [
          "reportgenerator \"-reports:tests/**/TestResults/**/coverage.cobertura.xml\" \"-targetdir:coverage-badges\" \"-reporttypes:Badges\" \"-verbosity:Warning\""
        ],
        "parallel": false
      }
    },
    "ci": {
      "//": "Orchestrates full CI pipeline: restore, build, test, and coverage report",
      "executor": "nx:run-commands",
      "dependsOn": [ "coverage:report" ],
      "options": {
        "commands": [
          "echo '✓ CI pipeline complete'"
        ],
        "parallel": false
      }
    },
    "test": {
      "//": "Runs tests with coverage collection (legacy target for compatibility)",
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "dotnet test Flowthru.slnx --collect:\"XPlat Code Coverage\" --settings coverlet.runsettings --logger \"console;verbosity=minimal\""
        ],
        "parallel": false
      },
      "configurations": {
        "report": {
          "options": {
            "commands": [
              "nx run purge:coverage",
              "nx run test || true",
              "reportgenerator \"-reports:tests/**/TestResults/**/coverage.cobertura.xml\" \"-targetdir:CoverageReport\" \"-reporttypes:Html;Badges\" && echo \"✓ Consolidated coverage report: CoverageReport/index.html\"' ",
              "open CoverageReport/index.html"
            ]
          }
        }
      }
    },
    "purge": {
      "//": "Purges non-essential files and folders",
      "executor": "nx:run-commands",
      "options": {
        "commands": [ ],
        "cwd": "",
        "parallel": false
      },
      "configurations": {
        "coverage": {
          "//": "Purges previous coverage reports",
          "options": {
            "commands": [
              "echo 'Purging previous coverage data...'",
              "find tests -name TestResults -type d -exec rm -rf {} + 2>/dev/null || true",
              "rm -rf CoverageReport"
            ]
          }
        }
      }
    },
    "format": {
      "//": "Applies all formatting for the project",
      "executor": "nx:run-commands",
      "options": {
        "commands": [ ],
        "cwd": "project.json",
        "parallel": false
      },
      "configurations": {
        "csharp": {
          "options": {
            "commands": [
              "dotnet csharpier ."
            ],
            "cwd": ".",
            "parallel": false
          }
        }
      }
    },
    "publish": {
      "//": "Prepares and packages all Flowthru NuGet packages for publication",
      "executor": "nx:run-commands",
      "dependsOn": [ "build:release", "_inject_agents_md" ],
      "options": {
        "commands": [
          "echo 'Cleaning previous packages...'",
          "rm -rf dist/packages 2>/dev/null || true",
          "echo 'Injecting version into templates...'",
          "./scripts/inject-template-version.sh",
          "echo 'Packing NuGet packages...'",
          "dotnet pack src/core/Flowthru/Flowthru.csproj --configuration Release --no-build",
          "dotnet pack src/extensions/Flowthru.Extensions.EFCore/Flowthru.Extensions.EFCore.csproj --configuration Release --no-build",
          "dotnet pack src/extensions/Flowthru.Extensions.MLNet/Flowthru.Extensions.MLNet.csproj --configuration Release --no-build",
          "dotnet pack src/extensions/Flowthru.Extensions.Python/Flowthru.Extensions.Python.csproj --configuration Release --no-build",
          "dotnet pack src/extensions/Flowthru.Extensions.Python.SourceGenerators/Flowthru.Extensions.Python.SourceGenerators.csproj --configuration Release --no-build",
          "dotnet pack src/misc/Flowthru.Misc.ML/Flowthru.Misc.ML.csproj --configuration Release --no-build",
          "echo '✓ NuGet packages created:'",
          "ls -lh dist/packages/*.nupkg"
        ],
        "parallel": false
      }
    },
    "release": {
      "//": "Calculates next semantic version and generates changelog based on conventional commits",
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "commit-and-tag-version --skip.commit --skip.tag"
        ],
        "parallel": false
      }
    },
    "_inject_agents_md": {
      "//": "Copies the canonical AGENTS.md into each starter template before packing",
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cp docs/guides/misc/AGENTS.md examples/starter/KedroIris/AGENTS.md",
          "cp docs/guides/misc/AGENTS.md examples/starter/KedroIrisPython/AGENTS.md",
          "cp docs/guides/misc/AGENTS.md examples/starter/KedroSpaceflights/AGENTS.md",
          "cp docs/guides/misc/AGENTS.md examples/starter/KedroSpaceflightsPython/AGENTS.md",
          "cp docs/guides/misc/AGENTS.md examples/starter/Minimal/AGENTS.md",
          "cp docs/guides/misc/AGENTS.md examples/starter/SpaceflightsEFCore/AGENTS.md"
        ],
        "parallel": false
      }
    }
  }
}
