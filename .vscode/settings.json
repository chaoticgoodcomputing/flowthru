{
  "[csharp]": {
    "editor.rulers": [
      90,
      100
    ],
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "csharpier.csharpier-vscode",
    "editor.formatOnSave": true
  },
  "dotnet.solution.autoOpen": "Flowthru.slnx",
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "docs/reference/misc/external/*/repo/**/*": true,
    "dist/**/*": true,
    "**/.venv/**/*": true
  }
}
