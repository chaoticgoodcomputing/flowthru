{
  "Flowthru": {
    "Catalog": {
      "Type": "MagicAtlas.Data.Catalog",
      "ConstructorArgs": {
        "basePath": "Data"
      }
    },
    "Pipelines": {
      "CardProcessing": {
        "FilterOptions": {
          "Format": "commander",
          "Colors": null,
          "ColorIdentity": null,
          "Types": null,
          "Rarities": null,
          "Sets": null,
          "MinCmc": null,
          "MaxCmc": null,
          "ExcludeDigital": true,
          "ExcludePromo": true,
          "ExcludeUnreleased": false
        }
      },
      "AtlasDiagnostics": {
        "NodeOptions": {
          "NeighborCount": 100,
          "TargetCardNames": [
            "The Wise Mothman"
          ],
          "RandomSampling": {
            "Seed": null,
            "TargetCount": 20
          }
        }
      }
    },
    "Metadata": {
      "OutputDirectory": "Metadata",
      "Providers": [ "json", "mermaid" ],
      "Json": {
        "WriteIndented": true
      },
      "Mermaid": {
        "Direction": "LR"
      }
    },
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Flowthru": "Debug",
        "Microsoft": "Warning"
      }
    }
  }
}
