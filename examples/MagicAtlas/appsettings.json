{
  "Flowthru": {
    "Catalog": {
      "Type": "MagicAtlas.Data.Catalog",
      "ConstructorArgs": {
        "basePath": "Data"
      }
    },
    "Pipelines": {
      "CardProcessing": {
        "FilterOptions": {
          "Format": "commander",
          "Colors": null,
          "ColorIdentity": null,
          "Types": null,
          "Rarities": null,
          "Sets": null,
          "MinCmc": null,
          "MaxCmc": null,
          "ExcludeDigital": true,
          "ExcludePromo": true,
          "ExcludeUnreleased": false
        }
      },
      "EmbeddingAnalytics": {
        "NearestNeighborOptions": {
          "NeighborCount": 5,
          "ExcludedTextTypes": [ "KeywordAbility" ],
          "TargetCardNames": [
            "Sol Ring",
            "Chatterfang, Squirrel General",
            "Wrath of God",
            "Counterspell",
            "Lightning Bolt",
            "Ravages of War"
          ],
          "RandomSampling": {
            "Seed": null,
            "TargetCount": 20
          }
        },
        "EmbeddingSamplingParams": {
          "SampleCount": 10,
          "Seed": 42
        },
        "DistributionChartParams": {
          "BinCount": 8
        },
        "ClusteringParams": {
          "NumberOfClusters": 16,
          "Seed": 42
        },
        "EnrichmentParams": {
          "TopN": 5
        }
      }
    },
    "Metadata": {
      "OutputDirectory": "Metadata",
      "Providers": [ "json", "mermaid" ],
      "Json": {
        "WriteIndented": true
      },
      "Mermaid": {
        "Direction": "LR"
      }
    },
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Flowthru": "Debug",
        "Microsoft": "Warning"
      }
    }
  }
}
