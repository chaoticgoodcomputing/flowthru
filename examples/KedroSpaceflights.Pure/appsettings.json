{
  "Flowthru": {
    "Catalog": {
      "Type": "KedroSpaceflights.Pure.Data.Catalog",
      "ConstructorArgs": {
        "basePath": "Data"
      }
    },
    "Pipelines": {
      "DataScience": {
        "ModelOptions": {
          "TestSize": 0.2,
          "RandomState": 3,
          "Features": [
            "engines",
            "passenger_capacity",
            "crew",
            "d_check_complete",
            "iata_approved",
            "company_rating",
            "review_scores_rating"
          ]
        }
      }
    },
    "Metadata": {
      "OutputDirectory": "Metadata",
      "Providers": [ "json", "mermaid" ],
      "Json": {
        "WriteIndented": true
      },
      "Mermaid": {
        "Direction": "LR"
      }
    },
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Flowthru": "Debug",
        "Microsoft": "Warning"
      }
    }
  }
}
