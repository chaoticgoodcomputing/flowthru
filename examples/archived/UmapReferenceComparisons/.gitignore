# Build outputs
bin/
obj/
dist/

# Python virtual environment
.venv/
__pycache__/
*.pyc

# Ignore all generated dataset files by default
Data/**/*.parquet
Data/**/*.json
Data/**/*.csv
Data/**/*.xlsx
Data/**/*.png

# Keep directory structure
!Data/**/.gitkeep

# Keep schemas (these are source code)
!Data/**/*.cs

# Keep small raw datasets (iris, digits) and their reference outputs
!Data/_01_Raw/Datasets/Inputs/iris/input.parquet
!Data/_01_Raw/Datasets/Inputs/digits/input.parquet
!Data/_01_Raw/Datasets/Reference/iris/output.parquet
!Data/_01_Raw/Datasets/Reference/digits/output.parquet

# Metadata (auto-generated)
Metadata/

# IDE
.vs/
.vscode/
*.user
*.suo
