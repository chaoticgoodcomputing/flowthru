<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DiarizationExample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Flowthru" />
    <PackageReference Include="Flowthru.Extensions.Python" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="pyproject.toml" CopyToOutputDirectory="PreserveNewest" />
    <!-- uv.lock is generated by `uv lock` / `uv sync`; gate copy on existence so
         the project builds before the user has run uv. -->
    <Content Include="uv.lock"
             CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('uv.lock')" />
    <Content Include=".python-version" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="$(RepoRoot)build/FlowthruInRepoSwap.props"
          Condition="'$(RepoRoot)' != '' AND Exists('$(RepoRoot)build/FlowthruInRepoSwap.props')" />

</Project>
