{
  "name": "umap-reference-comparisons",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "examples/UmapReferenceComparisons",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build",
        "cwd": "examples/UmapReferenceComparisons"
      }
    },
    "run-iris": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run -- IrisComparison",
        "cwd": "examples/UmapReferenceComparisons"
      },
      "dependsOn": ["build"]
    },
    "run-digits": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run -- DigitsComparison",
        "cwd": "examples/UmapReferenceComparisons"
      },
      "dependsOn": ["build"]
    },
    "run-mnist": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run -- MnistComparison",
        "cwd": "examples/UmapReferenceComparisons"
      },
      "dependsOn": ["build"]
    },
    "run-all": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "dotnet run -- IrisComparison",
          "dotnet run -- DigitsComparison",
          "dotnet run -- MnistComparison"
        ],
        "cwd": "examples/UmapReferenceComparisons",
        "parallel": false
      },
      "dependsOn": ["build"]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet clean",
        "cwd": "examples/UmapReferenceComparisons"
      }
    }
  },
  "tags": ["type:example", "scope:ml", "scope:umap"]
}
