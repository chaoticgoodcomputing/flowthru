{
  "Flowthru": {
    "Metadata": {
      "OutputDirectory": "Data/Metadata",
      "Providers": [ "json", "mermaid" ],
      "Json": {
        "WriteIndented": true
      },
      "Mermaid": {
        "Direction": "LR"
      }
    },
    "Pipelines": {
      "DataScience": {
        "ModelParams": {
          "TestSize": 0.2,
          "RandomState": 42
        }
      },
      "DataEvaluation": {
        "CrossValidationParams": {
          "NumFolds": 20,
          "BaseSeed": 42,
          "KedroReferenceR2Score": 0.387
        }
      }
    },
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Flowthru": "Debug",
        "System": "Warning",
        "Microsoft": "Warning"
      }
    }
  }
}
