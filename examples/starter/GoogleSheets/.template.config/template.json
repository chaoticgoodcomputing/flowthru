{
  "$schema": "http://json.schemastore.org/template",
  "author": "Chaotic Good Computing",
  "classifications": [
    "Data Engineering",
    "Data Science",
    "Flow",
    "Google Sheets"
  ],
  "identity": "Flowthru.Starter.GoogleSheets",
  "name": "Flowthru Starter: Google Sheets",
  "shortName": "Flowthru.GoogleSheets",
  "description": "Read from and write to a Google Sheet through the catalog (runs offline against the in-memory gateway)",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "GoogleSheets",
  "preferNameDirectory": true,
  "symbols": {
    "FlowthruVersion": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "0.25.0",
      "replaces": "FlowthruVersion",
      "description": "Flowthru package version (auto-injected at pack time)"
    }
  },
  "primaryOutputs": [
    {
      "path": "GoogleSheets.csproj"
    }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
