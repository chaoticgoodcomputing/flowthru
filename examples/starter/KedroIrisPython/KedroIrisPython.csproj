<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>KedroIrisPython</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/core/Flowthru/Flowthru.csproj" />
    <ProjectReference Include="../../../src/extensions/Flowthru.Extensions.Python/Flowthru.Extensions.Python.csproj" />
  </ItemGroup>

  <!-- 
    Python environment files for uv sync.
    These are copied to the output directory during build. At runtime, PythonRuntime.Initialize()
    automatically runs "uv sync" with the frozen flag to materialize .venv/ using these files.
  -->
  <ItemGroup>
    <Content Include="pyproject.toml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="uv.lock" CopyToOutputDirectory="PreserveNewest" />
    <Content Include=".python-version" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- TODO: Import MSBuild targets for Python schema generation (requires PackageReference or path override) -->
  <!-- <Import Project="../../../src/extensions/Flowthru.Extensions.Python/build/Flowthru.Extensions.Python.targets" /> -->

</Project>
