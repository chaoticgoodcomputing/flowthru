<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KedroIrisPython</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Flowthru" />
    <PackageReference Include="Flowthru.Extensions.Python" />
  </ItemGroup>

  <!-- Python environment files for uv sync. Copied to the output directory during
       build. PythonRuntime.Initialize() runs uv sync at startup to materialize .venv/. -->
  <ItemGroup>
    <Content Include="pyproject.toml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="uv.lock" CopyToOutputDirectory="PreserveNewest" />
    <Content Include=".python-version" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="$(RepoRoot)build/FlowthruInRepoSwap.props"
          Condition="'$(RepoRoot)' != '' AND Exists('$(RepoRoot)build/FlowthruInRepoSwap.props')" />

</Project>
