## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider
.idea/

# Generated metadata
Metadata/

# Data outputs (keep raw data)
Data/_02_Intermediate/Datasets/**/*
Data/_03_Primary/Datasets/**/*
Data/_04_Feature/Datasets/**/*
Data/_05_ModelInput/Datasets/**/*
Data/_06_Models/Datasets/**/*
Data/_07_ModelOutput/Datasets/**/*
Data/_08_Reporting/Datasets/**/*
!Data/**/Datasets/.gitkeep
