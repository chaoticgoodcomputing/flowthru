{
  "Flowthru": {
    "Pipelines": {
      "DataEngineering": {
        "TestDataRatio": 0.2
      },
      "DataScience": {
        "NumTrainIter": 10000,
        "LearningRate": 0.01
      }
    },
    "Metadata": {
      "OutputDirectory": "Metadata",
      "Providers": [ "json", "mermaid" ],
      "Json": {
        "WriteIndented": true
      },
      "Mermaid": {
        "Direction": "LR"
      }
    },
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Flowthru": "Debug",
        "Microsoft": "Warning"
      }
    }
  }
}
