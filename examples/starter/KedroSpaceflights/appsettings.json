{
  "Flowthru": {
    "Pipelines": {
      "DataScience": {
        "ModelOptions": {
          "TestSize": 0.2,
          "RandomState": 3,
          "Features": [
            "engines",
            "passenger_capacity",
            "crew",
            "d_check_complete",
            "iata_approved",
            "company_rating",
            "review_scores_rating"
          ]
        }
      },
      "Reporting": {
        "ConfusionMatrixOptions": {
          "NumBins": 5
        }
      }
    },
    "Metadata": {
      "OutputDirectory": "Metadata",
      "Providers": [ "json", "mermaid" ],
      "FilenameTemplate": "dag-{PipelineName}-{Timestamp}-{SliceType}",
      "Timestamp": {
        "IncludeTimestamp": true,
        "Format": "yyyy-MM-dd-HH-mm-ss"
      },
      "Json": {
        "WriteIndented": true
      },
      "Mermaid": {
        "Direction": "TB"
      }
    },
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Flowthru": "Debug",
        "Microsoft": "Warning"
      }
    }
  }
}
