<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Prevents Microsoft.NET.Test.Sdk from injecting its own AutoGeneratedProgram.Main,
         which would conflict with this project's Program.Main entry point. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <!-- Define FUNIT_ENABLED so colocated test classes are conditionally compiled out of Release -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);FUNIT_ENABLED</DefineConstants>
  </PropertyGroup>

  <!-- Explicit extension references — no barrel Flowthru meta-package -->
  <ItemGroup Condition="Exists('$(RepoRoot)src/core/Flowthru.Core/Flowthru.Core.csproj')">
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru/Flowthru.csproj" />
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.FUnit/Flowthru.FUnit.csproj" />
    <!-- FUnit's source generators ship via NuGet `analyzers/` when consumed as a package,
         but project references do not transitively flow analyzer references. Add an explicit
         analyzer reference so [StepTest]-decorated methods get NUnit runner classes emitted. -->
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.FUnit.SourceGenerators/Flowthru.FUnit.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Csv/Flowthru.Extensions.Csv.csproj" />
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Xml/Flowthru.Extensions.Xml.csproj" />
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Python/Flowthru.Extensions.Python.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(RepoRoot)src/core/Flowthru.Core/Flowthru.Core.csproj')">
    <PackageReference Include="Flowthru" Version="FlowthruVersion" />
    <PackageReference Include="Flowthru.FUnit" Version="FlowthruVersion" />
    <PackageReference Include="Flowthru.Extensions.Csv" Version="FlowthruVersion" />
    <PackageReference Include="Flowthru.Extensions.Xml" Version="FlowthruVersion" />
    <PackageReference Include="Flowthru.Extensions.Python" Version="FlowthruVersion" />
  </ItemGroup>

  <!-- NUnit + Test SDK: only included in Debug so Release builds carry zero test infrastructure -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Python environment files: uv sync materialises .venv/ at runtime -->
    <Content Include="pyproject.toml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="uv.lock" CopyToOutputDirectory="PreserveNewest" />
    <Content Include=".python-version" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
