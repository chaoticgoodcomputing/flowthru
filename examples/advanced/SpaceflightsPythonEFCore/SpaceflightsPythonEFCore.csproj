<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpaceflightsPythonEFCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Flowthru" Version="FlowthruVersion" />
    <PackageReference Include="Flowthru.Extensions.EFCore" Version="FlowthruVersion" />
    <PackageReference Include="Flowthru.Extensions.Python" Version="FlowthruVersion" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="pyproject.toml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="uv.lock" CopyToOutputDirectory="PreserveNewest" />
    <Content Include=".python-version" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="$(RepoRoot)build/FlowthruInRepoSwap.props"
          Condition="'$(RepoRoot)' != '' AND Exists('$(RepoRoot)build/FlowthruInRepoSwap.props')" />

</Project>
