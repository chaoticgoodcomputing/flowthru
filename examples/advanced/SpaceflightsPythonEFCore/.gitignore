# Python virtual environment
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Generated Python schemas
_generated/

# Build artifacts
bin/
obj/
*.user
*.suo

# Dataset directories - ignore generated outputs, but keep raw input data
Data/**/Datasets
!Data/_01_Raw/Datasets
!Data/_01_Raw/Datasets/*

# Ignore generated pipeline output files
*.db
*.db-shm
*.db-wal
Data/**/*.png
Data/**/*.json

# Un-ignore all .gitkeep files anywhere
!**/.gitkeep

Metadata
