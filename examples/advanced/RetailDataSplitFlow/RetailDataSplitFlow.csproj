<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RetailDataMultipipeline</RootNamespace>
  </PropertyGroup>

  <!-- Explicit extension references — no barrel Flowthru meta-package -->
  <ItemGroup>
    <PackageReference Include="Flowthru.Core" Version="FlowthruVersion" />
    <PackageReference Include="Flowthru.Extensions.Csv" Version="FlowthruVersion" />
    <PackageReference Include="Flowthru.Extensions.Http" Version="FlowthruVersion" />
    <PackageReference Include="Flowthru.Extensions.Parquet" Version="FlowthruVersion" />
    <PackageReference Include="Flowthru.Extensions.Python" Version="FlowthruVersion" />
    <PackageReference Include="Flowthru.Extensions.Metadata.Json" Version="FlowthruVersion" />
    <PackageReference Include="Flowthru.Extensions.Metadata.Mermaid" Version="FlowthruVersion" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="pyproject.toml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="uv.lock" CopyToOutputDirectory="PreserveNewest" />
    <Content Include=".python-version" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="$(RepoRoot)build/FlowthruInRepoSwap.props"
          Condition="'$(RepoRoot)' != '' AND Exists('$(RepoRoot)build/FlowthruInRepoSwap.props')" />

</Project>
