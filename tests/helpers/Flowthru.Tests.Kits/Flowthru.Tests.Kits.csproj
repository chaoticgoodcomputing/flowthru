<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- NUnit1017: TestCaseSource must be static.
         Suppressed at the kit level because conformance bases require instance sources:
         each subclass overrides FlatFixtures/NestedFixtures/MixedFixtures to declare which
         fixtures it runs. NUnit runtime supports instance sources; only the analyzer flags
         them. The trade-off is intentional. -->
    <NoWarn>$(NoWarn);NUnit1017</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core/Flowthru.Core.csproj" />
    <!-- Source generators are referenced as analyzers so [FlowthruSchema]-marked
         row types in conformance fixtures (e.g., SerializedEnumConformance.KitRow)
         get their IStructuredSerializable surface emitted at kit-build time. -->
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core.SourceGenerators/Flowthru.Core.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures/**/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    During the FP rewrite, kit directories and files that depend on types
    not yet rebuilt are excluded from compilation. Each is restored as the
    corresponding phase brings its target types back online:
      Phase 2: Schemas/, Format/, Storage/, Medium/, Lifecycle/
      Phase 4 (or later cleanup): Effects/{FlowResource,Ephemeral}Conformance.cs —
        these need rewriting against the new Task<EffResult<A>> Run signature
        and are deferred until catalog/storage types they exercise are back online.
  -->
  <ItemGroup>
    <Compile Remove="Fixtures/FixtureLoader.cs" />
    <Compile Remove="Format/**/*.cs" />
    <Compile Remove="Lifecycle/**/*.cs" />
    <Compile Remove="Medium/**/*.cs" />
    <Compile Remove="Metadata/**/*.cs" />
    <Compile Remove="Schemas/**/*.cs" />
    <Compile Remove="Storage/StorageAdapterAssertions.cs" />
    <Compile Remove="Storage/StorageAdapterTraitsConformance.cs" />
    <Compile Remove="Storage/StorageAdapterConformance.cs" />
    <Compile Remove="Storage/DirectoryStorageAdapterConformance.cs" />
    <Compile Remove="Storage/DirectoryEqualityComparer.cs" />
    <Compile Remove="Prelude/FlowResourceConformance.cs" />
    <Compile Remove="Prelude/EphemeralResourceConformance.cs" />
  </ItemGroup>

</Project>
