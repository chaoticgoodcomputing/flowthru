<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Pre-rewrite generator/metadata helpers — quarantined pending FP-rewrite migration.
       These helpers reference legacy namespaces (Flowthru.Core.Data, Flowthru.Core.SourceGenerators.*,
       IMetadataProvider, DagMetadata) that don't exist post-rewrite. Their consumers in
       tests/core/Flowthru.Core.Tests/{01_Compilation,02_Validation,04_Services} are
       quarantined under <Compile Remove> in that csproj, so no active test depends on them
       today. Reactivate alongside the Phase-7.5 test-debt recovery work when those
       categories come back online. -->
  <ItemGroup>
    <Compile Remove="CapturingMetadataProvider.cs" />
    <Compile Remove="CompilationTestHelper.cs" />
    <Compile Remove="FUnitGeneratorTestHelper.cs" />
    <Compile Remove="GeneratorTestHelper.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" />
    <!-- Explicit overrides to force NuGet past the 1.0.1 minimum that CodeFix.Testing 1.1.x requests -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="Microsoft.ML" />
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <!-- Flowthru references — swapped to ProjectReference in-repo via FlowthruInRepoSwap.props.
         The bare `FUnit` identity (not `Flowthru.FUnit`) matches the package id and the
         src/funit/FUnit/ directory layout post-graduation (§4.5 — Phase 5 carryover). -->
    <PackageReference Include="Flowthru" Version="FlowthruVersion" />
    <PackageReference Include="FUnit" Version="FlowthruVersion" />

    <!-- Source generator DLLs as REGULAR runtime dependencies (note ReferenceOutputAssembly=true).
         Tests.Helpers drives CSharpGeneratorDriver against the SGs in-process, so the SG
         assemblies must be loadable as normal libraries — not analyzer-only references —
         and coverlet must be able to instrument them through this project's dependency chain
         to record hits. The Flowthru.Core.targets file (imported transitively by
         FlowthruInRepoSwap.props) adds these same projects as analyzer references; the
         analyzer and runtime references coexist for the same csproj. -->
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core.SourceGenerators/Flowthru.Core.SourceGenerators.csproj"
                      ReferenceOutputAssembly="true" />
    <ProjectReference Include="$(RepoRoot)src/funit/FUnit.SourceGenerators/FUnit.SourceGenerators.csproj"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

  <Import Project="$(RepoRoot)build/FlowthruInRepoSwap.props"
          Condition="'$(RepoRoot)' != '' AND Exists('$(RepoRoot)build/FlowthruInRepoSwap.props')" />

</Project>
