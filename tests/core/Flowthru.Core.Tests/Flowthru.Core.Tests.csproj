<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core/Flowthru.Core.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/helpers/Flowthru.Tests.Kits/Flowthru.Tests.Kits.csproj" />
  </ItemGroup>

  <!--
    Wire the source generators as analyzers so [FlowthruSchema]-attributed
    fixture types in this project receive the generated marker interfaces.
    Required even though Flowthru.Core also references the generator —
    analyzer references don't propagate transitively across ProjectReferences.
  -->
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/core/Flowthru.Core.SourceGenerators/Flowthru.Core.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <!--
    During the FP rewrite, test directories that depend on types not yet
    rebuilt are excluded from compilation. Each is restored as the
    corresponding phase brings its target types back online:
      Phase 2: 01_Compilation/, _Fixtures/, Conformance/
      Phase 3: 03_Execution/
      Phase 4: 02_Validation/, 04_Services/, 05_Cli/, 06_Results/
    Existing Effects/ServiceRefTests.cs is excluded until ServiceRef
    re-lands in Phase 4.
  -->
  <ItemGroup>
    <Compile Remove="01_Compilation/**/*.cs" />
    <Compile Remove="02_Validation/**/*.cs" />
    <Compile Remove="03_Execution/**/*.cs" />
    <Compile Remove="04_Services/**/*.cs" />
    <Compile Remove="05_Cli/**/*.cs" />
    <Compile Remove="06_Results/**/*.cs" />
    <Compile Remove="Conformance/**/*.cs" />
    <Compile Remove="_Fixtures/**/*.cs" />
  </ItemGroup>

</Project>
