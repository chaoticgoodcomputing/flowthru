<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <!-- The translator returns Google SDK types; tests assert on them directly. -->
    <PackageReference Include="Google.Apis.Sheets.v4" />
    <!-- DI hosting tests build a service provider and resolve the gateway. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <!-- Controllable TimeProvider (FakeTimeProvider) for clock-driven backoff tests. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Google.Sheets/Flowthru.Extensions.Google.Sheets.csproj" />
    <!-- Drives the adapter's read path against the offline gateway (no live API). -->
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Google.Sheets.InMemory/Flowthru.Extensions.Google.Sheets.InMemory.csproj" />
  </ItemGroup>

</Project>
