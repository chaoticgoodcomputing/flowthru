<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Python/Flowthru.Extensions.Python.csproj" />
  </ItemGroup>

  <!--
    Copy the Python worker script, arrow IPC bridge, and the `flowthru` package
    to the test output directory so SubprocessPythonExecutorIntegrationTests can
    spawn a real worker against AppContext.BaseDirectory.

    The extension's own .targets file only attaches to consumers that reference
    the production project — it does NOT propagate Content items into a test
    project's output directly, so we replicate the relevant entries here.
  -->
  <ItemGroup>
    <Content Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Python/build/flowthru_worker.py"
             CopyToOutputDirectory="PreserveNewest"
             Link="flowthru_worker.py"
             Visible="false" />
    <Content Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Python/build/_flowthru_arrow.py"
             CopyToOutputDirectory="PreserveNewest"
             Link="_flowthru_arrow.py"
             Visible="false" />
    <Content Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Python/build/flowthru/__init__.py"
             CopyToOutputDirectory="PreserveNewest"
             Link="flowthru\__init__.py"
             Visible="false" />
    <Content Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Python/build/flowthru/step.py"
             CopyToOutputDirectory="PreserveNewest"
             Link="flowthru\step.py"
             Visible="false" />
    <Content Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Python/build/flowthru/validation.py"
             CopyToOutputDirectory="PreserveNewest"
             Link="flowthru\validation.py"
             Visible="false" />
    <Content Include="$(RepoRoot)src/extensions/Flowthru.Extensions.Python/build/flowthru/config.py"
             CopyToOutputDirectory="PreserveNewest"
             Link="flowthru\config.py"
             Visible="false" />
  </ItemGroup>

</Project>
