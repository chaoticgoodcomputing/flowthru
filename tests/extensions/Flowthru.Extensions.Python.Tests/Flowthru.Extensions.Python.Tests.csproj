<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the Python extension -->
    <ProjectReference Include="$(RepoRoot)src\extensions\Flowthru.Extensions.Python\Flowthru.Extensions.Python.csproj" />
    
    <!-- Reference the core library (for FlowthruServiceBuilder) -->
    <ProjectReference Include="$(RepoRoot)src\core\Flowthru\Flowthru.csproj" />
    
    <!-- Reference test common helpers (CompilationTestHelper) -->
    <ProjectReference Include="..\..\helpers\Flowthru.Tests.Helpers\Flowthru.Tests.Helpers.csproj" />
  </ItemGroup>

  <!--
    Python test files (*.py) should be copied to output directory.
    The MSBuild targets from the extension should handle this automatically,
    but we explicitly include test fixtures here for clarity.
  -->
  <ItemGroup>
    <Content Include="_Fixtures\**\*.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 
    Python environment files for uv sync.
    These are copied to the output directory during build. At runtime, PythonRuntime.Initialize()
    automatically runs "uv sync" with the frozen flag to materialize .venv/ using these files.
  -->
  <ItemGroup>
    <Content Include="pyproject.toml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="uv.lock" CopyToOutputDirectory="PreserveNewest" />
    <Content Include=".python-version" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Import Python extension .targets for schema export and generator registration -->
  <Import Project="$(RepoRoot)src\extensions\Flowthru.Extensions.Python\build\Flowthru.Extensions.Python.targets" />

</Project>
