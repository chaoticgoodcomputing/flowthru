{
  "name": "Flowthru.Tests.Templates",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "tests/Flowthru.Tests.Templates",
  "tags": [ "type:test" ],
  "targets": {
    "test": {
      "//": "Runs template tests. Requires all packs to be in dist/packages/ first — src/ lands flat, others under subdirectories.",
      "executor": "nx:run-commands",
      "dependsOn": [ "build", "templates:_pack_all" ],
      "options": {
        "commands": [ "dotnet test --no-build --no-restore" ],
        "cwd": "tests/Flowthru.Tests.Templates",
        "parallel": false,
        "forwardAllArgs": true
      }
    }
  }
}
