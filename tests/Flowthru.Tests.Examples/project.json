{
  "name": "test/examples",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "tests/Flowthru.Tests.Examples",
  "tags": [ "nx-dotnet", "type:test", "scope:examples" ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build",
        "cwd": "tests/Flowthru.Tests.Examples"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test --logger \"console;verbosity=normal\"",
        "cwd": "tests/Flowthru.Tests.Examples"
      }
    },
    "test:discovery": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test --filter \"FullyQualifiedName~Discovery\" --logger \"console;verbosity=normal\"",
        "cwd": "tests/Flowthru.Tests.Examples"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet csharpier {projectRoot}",
        "cwd": "{workspaceRoot}"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet csharpier {projectRoot} --check",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
