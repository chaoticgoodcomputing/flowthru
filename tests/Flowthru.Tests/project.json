{
  "name": "test/unit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "tests/Flowthru.Tests",
  "tags": [ "type:test", "scope:flowthru" ],
  "targets": {
    "compilation": {
      "//": "Run only compile-time error surface tests",
      "executor": "nx:run-commands",
      "options": {
        "commands": [ "dotnet test --filter \"Category=Compilation\"" ],
        "cwd": "tests/Flowthru.Tests",
        "parallel": false
      }
    },
    "validation": {
      "//": "Run only pre-flight validation tests",
      "executor": "nx:run-commands",
      "options": {
        "commands": [ "dotnet test --filter \"Category=Validation\"" ],
        "cwd": "tests/Flowthru.Tests",
        "parallel": false
      }
    },
    "execution": {
      "//": "Run only runtime execution tests",
      "executor": "nx:run-commands",
      "options": {
        "commands": [ "dotnet test --filter \"Category=Execution\"" ],
        "cwd": "tests/Flowthru.Tests",
        "parallel": false
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet csharpier {projectRoot}",
        "cwd": "{workspaceRoot}"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet csharpier {projectRoot} --check",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
