<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <!-- Python.NET reads this during static initialization (ignored in 3.7.x, but keep for documentation) -->
      <PYTHONNET_PYDLL>/Users/spelkington/.local/share/uv/python/cpython-3.13.3-macos-aarch64-none/lib/libpython3.13.dylib</PYTHONNET_PYDLL>
      
      <!-- Tell macOS dyld where to find Python libraries -->
      <DYLD_LIBRARY_PATH>/Users/spelkington/.local/share/uv/python/cpython-3.13.3-macos-aarch64-none/lib</DYLD_LIBRARY_PATH>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>



