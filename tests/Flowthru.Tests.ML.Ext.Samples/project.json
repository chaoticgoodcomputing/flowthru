{
  "name": "Flowthru.Tests.ML.Ext.Samples",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/Flowthru.Tests.ML.Ext.Samples",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build",
        "cwd": "tests/Flowthru.Tests.ML.Ext.Samples"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test --no-build",
        "cwd": "tests/Flowthru.Tests.ML.Ext.Samples"
      },
      "dependsOn": ["build"]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet clean",
        "cwd": "tests/Flowthru.Tests.ML.Ext.Samples"
      }
    }
  },
  "tags": ["type:test", "scope:ml"]
}
