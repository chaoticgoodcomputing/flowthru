{
  "name": "Flowthru.Tests.Examples",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "tests/Flowthru.Tests.Examples",
  "implicitDependencies": [ ],
  "tags": [ "type:test", "scope:examples" ],
  "targets": {
    "test": {
      "//": "Runs only affected example projects via scripts/run-tests.sh. Each example gets its own dotnet test invocation producing TestResults/{Name}/coverage.cobertura.xml.",
      "executor": "nx:run-commands",
      "dependsOn": [ "build" ],
      "options": {
        "commands": [ "bash scripts/run-tests.sh" ],
        "cwd": "tests/integration/Flowthru.Tests.Examples",
        "parallel": false,
        "forwardAllArgs": true
      },
      "cache": true,
      "inputs": [ "default", "{workspaceRoot}/src/**", "{workspaceRoot}/examples/**" ]
    },
    "test:all": {
      "//": "Runs every discovered example (--run-all flag). Identical output structure to test — each example gets TestResults/{Name}/coverage.cobertura.xml.",
      "executor": "nx:run-commands",
      "dependsOn": [ "build" ],
      "options": {
        "commands": [ "bash scripts/run-tests.sh --run-all" ],
        "cwd": "tests/integration/Flowthru.Tests.Examples",
        "parallel": false,
        "forwardAllArgs": true
      }
    },
    "test:discovery": {
      "//": "Run only test discovery tests (smoke check for example project wiring)",
      "executor": "nx:run-commands",
      "options": {
        "commands": [ "dotnet test --filter \"FullyQualifiedName~Discovery\" --logger \"console;verbosity=normal\"" ],
        "cwd": "tests/integration/Flowthru.Tests.Examples",
        "parallel": false
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet csharpier {projectRoot}",
        "cwd": "{workspaceRoot}"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet csharpier {projectRoot} --check",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
