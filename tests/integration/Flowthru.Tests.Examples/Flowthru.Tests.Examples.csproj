<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Force vstest to pick up the local coverlet.runsettings on every dotnet test
         invocation. Without this, dotnet test with no-build and no-restore skips
         runsettings auto-discovery, falling back to defaults that don't honor our
         per-example exclude/file filters (notably [FlowthruCoverage]* and the .g.cs
         file pattern). Overrides the repo-wide RunSettingsFilePath set by
         Directory.Build.targets for IsTestProject. -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/coverlet.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <!-- Flowthru framework — swapped to ProjectReference in-repo via FlowthruInRepoSwap.props. -->
    <PackageReference Include="Flowthru" Version="FlowthruVersion" />

    <!-- Pull in every example project for coverage collection. New examples anywhere
         under examples/ are automatically discovered. examples/archived/ is excluded —
         archived projects aren't run by the harness. Library sub-projects (no
         OutputType=Exe) are filtered at runtime by ExampleDiscovery via
         Assembly.EntryPoint — only executable assemblies become test cases. -->
    <ProjectReference Include="$(RepoRoot)examples/**/*.csproj"
                      Exclude="$(RepoRoot)examples/archived/**/*.csproj" />
  </ItemGroup>

  <!--
    Unified Python environment for test scenarios. Contains all dependencies from
    KedroSpaceflightsPython and KedroIrisPython. PythonEngine can only initialize
    once per process, so all Python examples running in the same test host must
    share this .venv.
  -->
  <ItemGroup>
    <Content Include="pyproject.toml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="uv.lock" CopyToOutputDirectory="PreserveNewest" />
    <Content Include=".python-version" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="$(RepoRoot)build/FlowthruInRepoSwap.props"
          Condition="'$(RepoRoot)' != '' AND Exists('$(RepoRoot)build/FlowthruInRepoSwap.props')" />

</Project>
