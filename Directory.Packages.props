    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.12.0" /> <!-- tracks current stable; revisit before publish -->

    <!-- Roslyn analyzer testing harness (used by tests/ for source-generator and code-fix tests) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.2" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.NUnit" Version="1.1.2" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.2" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing.NUnit" Version="1.1.2" /> <!-- tracks current stable; revisit before publish -->

    <!-- Test infrastructure (NUnit + Test Sdk + coverage) -->
    <PackageVersion Include="coverlet.collector" Version="6.0.2" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="NUnit" Version="4.2.2" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="NUnit.Analyzers" Version="4.4.0" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" /> <!-- tracks current stable; revisit before publish -->
  </ItemGroup>

</Project>
