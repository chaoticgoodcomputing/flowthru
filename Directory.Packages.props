<!--
  Directory.Packages.props — Central Package Management for the Flowthru monorepo.

  Every <PackageReference> in any in-repo csproj resolves its version from this file.
  Consumer csprojs use <PackageReference Include="X" /> (no Version attribute);
  NuGet picks up the version from the matching <PackageVersion> entry below.

  CentralPackageTransitivePinningEnabled=true forces transitive dependencies to
  the centrally-declared version too — this is what lets the glob-based
  FlowthruInRepoSwap.props add ProjectReferences to every Flowthru runtime
  package without causing version conflicts: there is exactly one version of
  each non-Flowthru package across the entire repo.

  When templates are instantiated to an end-user's directory, this file is not
  inherited (it lives at our repo root, not the user's). Templates ship their
  own per-template Directory.Packages.props as content, declaring versions for
  the non-Flowthru packages they use. The csproj inside the template uses
  <PackageReference Include="X" /> (no version) and resolves against that
  per-template file in the user's directory.
-->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Flowthru framework dependencies (used by src/) -->
    <PackageVersion Include="Apache.Arrow" Version="23.0.0" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.23" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="ClosedXML" Version="0.105.0" />
    <PackageVersion Include="CsvHelper" Version="33.0.1" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="DuckDB.NET.Data.Full" Version="1.5.3" /> <!-- tracks current stable; bundles native binaries for all supported RIDs -->
    <PackageVersion Include="EFCore.BulkExtensions" Version="10.0.1" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="ExcelDataReader" Version="3.7.0" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="ExcelDataReader.DataSet" Version="3.7.0" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Google.Apis.Auth" Version="1.74.0" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Google.Apis.Sheets.v4" Version="1.74.0.4061" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="HotChocolate.AspNetCore" Version="15.1.14" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="MathNet.Numerics" Version="5.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.4" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.4" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.4" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Npgsql" Version="10.0.3" /> <!-- raw binary COPY rung for AddBulkTransfer; tracks the EF provider's Npgsql floor -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.6.0" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Testcontainers" Version="4.6.0" /> <!-- core; MinIO container backend for the S3 gateway-law matrix -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.4" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.4" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.4" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.4" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.4" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.4" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.4" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.4" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.4" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.4" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.0.0" /> <!-- FakeTimeProvider for clock-driven tests; revisit before publish -->
    <PackageVersion Include="Microsoft.ML" Version="4.0.3" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.ML.DataView" Version="4.0.3" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Microsoft.ML.OnnxTransformer" Version="4.0.3" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Parquet.Net" Version="5.6.0" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Snappier" Version="1.3.1" /> <!-- GHSA-pggp-6c3x-2xmx fix; 1.3.0 ships transitively via Parquet.Net 5.6.0. Remove once Parquet.Net bumps. -->
    <PackageVersion Include="StrawberryShake.Core" Version="15.1.14" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="StrawberryShake.Server" Version="15.1.14" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />

    <!-- Web/ASP.NET Core (used by SpaceflightsGQL) -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.5" /> <!-- tracks current stable; revisit before publish -->

    <!-- Plotting (used by spaceflights examples) -->
    <PackageVersion Include="Plotly.NET" Version="5.1.0" /> <!-- tracks current stable; revisit before publish -->
    <PackageVersion Include="Plotly.NET.CSharp" Version="0.13.0" />
    <PackageVersion Include="Plotly.NET.ImageExport" Version="6.1.0" /> <!-- tracks current stable; revisit before publish -->

    <!-- Roslyn / source generator authoring (used by src/ analyzer projects + Tests.Helpers) -->
