<!--
  FlowthruInRepoSwap.props — in-repo dual-mode reference resolver.

  Inside this monorepo, Flowthru is *always* consumed from source. There is no
  scenario in which an in-repo project consumes a published Flowthru NuGet
  package — that's reserved for end-user template instantiations, where this
  Import is skipped (the conditional Import in the consuming csproj evaluates
  false because $(RepoRoot) is undefined).

  Imported (conditionally) at the bottom of consuming csprojs:

    <Import Project="$(RepoRoot)build/FlowthruInRepoSwap.props"
            Condition="'$(RepoRoot)' != '' AND Exists('$(RepoRoot)build/FlowthruInRepoSwap.props')" />

  Algorithm: scan every <PackageReference> the consumer declared, derive the
  three candidate in-repo csproj paths (src/core/<Id>/<Id>.csproj,
  src/extensions/<Id>/<Id>.csproj, src/misc/<Id>/<Id>.csproj), and if any of
  them exist, remove the PackageReference and add a ProjectReference to the
  resolved path. There is no central registry of Flowthru packages — adding a
  new package to src/core, src/extensions, or src/misc is a zero-edit
  operation here, and the consumer just declares its <PackageReference> as
  normal. Non-Flowthru PackageReferences resolve to non-existent candidate
  paths and pass through unchanged.

  Why it works at evaluation time (where I previously thought it was
  impossible):

    - Item batching with %(Identity) in metadata VALUES (not Conditions)
      iterates per-item at evaluation time. `<X Update="@(X)" Path="...%(Identity)..." />`
      runs once per item with the right Identity substituted.
    - Same-item-type %(Meta) in Conditions on metadata elements is also
      allowed (the rejected pattern was cross-type metadata).
    - The Include/Exclude pair with WithMetadataValue() filters items by
      metadata without crossing item-type boundaries in a Condition.

    See https://learn.microsoft.com/en-us/visualstudio/msbuild/msbuild-items
    (the "Updating metadata on items in an ItemGroup outside of a Target"
    section).

  IMPORTANT: All work happens in evaluation-time ItemGroups (NOT in a Target).
  Static project-graph analyzers — @nx/dotnet, MSBuild's ProjectGraph, IDEs —
  read items at evaluation time, so the resolved ProjectReferences MUST be
  visible there for dependent csprojs to be scheduled for build correctly.
-->
<Project>

  <!-- Marker property: Directory.Build.targets reads this to skip its legacy fallback
       Core/FUnit targets imports for projects that have already opted into
       FlowthruInRepoSwap. Avoids double-importing the analyzer registration. -->
  <PropertyGroup>
    <FlowthruInRepoSwapImported>true</FlowthruInRepoSwapImported>
  </PropertyGroup>

  <!-- Step 1: Mirror every PackageReference into a candidate item type so we can
       attach custom metadata without touching the strict PackageReference schema. -->
  <ItemGroup>
    <_FlowthruCandidate Include="@(PackageReference)" />
  </ItemGroup>

  <!-- Step 2: Compute the three candidate in-repo csproj paths for each
       candidate. Same-item-type %(Identity) interpolated into metadata VALUES
       iterates per item at evaluation time. Non-Flowthru identities yield
       paths like src/core/Newtonsoft.Json/... that simply won't exist on disk. -->
  <ItemGroup>
    <_FlowthruCandidate Update="@(_FlowthruCandidate)">
      <CoreCsproj>$(RepoRoot)src/core/%(Identity)/%(Identity).csproj</CoreCsproj>
      <ExtensionsCsproj>$(RepoRoot)src/extensions/%(Identity)/%(Identity).csproj</ExtensionsCsproj>
      <MiscCsproj>$(RepoRoot)src/misc/%(Identity)/%(Identity).csproj</MiscCsproj>
    </_FlowthruCandidate>
  </ItemGroup>

  <!-- Step 3: Resolve to the first existing candidate. Same-item-type %(Meta)
       in Conditions on metadata elements is permitted; Exists() runs per item.
       Order matters: core wins over extensions wins over misc, but Flowthru
       package identities are unique across these directories so there's no
       actual conflict. -->
  <ItemGroup>
    <_FlowthruCandidate Update="@(_FlowthruCandidate)">
      <ResolvedPath Condition="Exists('%(CoreCsproj)')">%(CoreCsproj)</ResolvedPath>
      <ResolvedPath Condition="Exists('%(ExtensionsCsproj)')">%(ExtensionsCsproj)</ResolvedPath>
      <ResolvedPath Condition="Exists('%(MiscCsproj)')">%(MiscCsproj)</ResolvedPath>
    </_FlowthruCandidate>
  </ItemGroup>

  <!-- Step 4: Project candidates with non-empty ResolvedPath into two derived
       item lists — one keyed by csproj path (for ProjectReference Include) and
       one keyed by package Identity (for PackageReference Remove). The
       Include + Exclude with WithMetadataValue('ResolvedPath','') filters to
       items that actually resolved, sidestepping the cross-type-Condition
       restriction. -->
  <ItemGroup>
    <_FlowthruResolvedPath Include="@(_FlowthruCandidate->'%(ResolvedPath)')"
                           Exclude="@(_FlowthruCandidate->WithMetadataValue('ResolvedPath','')->'%(ResolvedPath)')" />

    <_FlowthruResolvedIdentity Include="@(_FlowthruCandidate->'%(Identity)')"
                               Exclude="@(_FlowthruCandidate->WithMetadataValue('ResolvedPath','')->'%(Identity)')" />
  </ItemGroup>

  <!-- Step 5: Swap. Remove the resolved PackageReferences and add the
       corresponding ProjectReferences. -->
  <ItemGroup>
    <PackageReference Remove="@(_FlowthruResolvedIdentity)" />
    <ProjectReference Include="@(_FlowthruResolvedPath)" />
  </ItemGroup>

  <!-- Always import the Flowthru.Core targets in-repo to register source generators
       + code fixes as analyzers. Mirrors NuGet's auto-import of the same file from
       the Flowthru.Core package. The targets file itself is dual-mode-aware. -->
  <Import Project="$(RepoRoot)src/core/Flowthru.Core/build/Flowthru.Core.targets"
          Condition="Exists('$(RepoRoot)src/core/Flowthru.Core/build/Flowthru.Core.targets')" />

</Project>
