<!--
  FlowthruInRepoSwap.props — in-repo dual-mode reference resolver.

  Inside this monorepo, Flowthru is *always* consumed from source. There is no
  scenario in which an in-repo project consumes a published Flowthru NuGet
  package — that's reserved for end-user template instantiations, where this
  Import is skipped (the conditional Import in the consuming csproj evaluates
  false because $(RepoRoot) is undefined).

  Imported (conditionally) at the bottom of consuming csprojs:

    <Import Project="$(RepoRoot)build/FlowthruInRepoSwap.props"
            Condition="'$(RepoRoot)' != '' AND Exists('$(RepoRoot)build/FlowthruInRepoSwap.props')" />

  Algorithm: scan every <PackageReference> the consumer declared, derive the
  six candidate in-repo csproj paths — three tiers (core, extensions, misc) ×
  two name patterns (literal Identity, and "Flowthru."-prefixed Identity) —
  and if any of them exist, remove the PackageReference and add a
  ProjectReference to the resolved path. There is no central registry of
  Flowthru packages — adding a new package to src/core, src/extensions, or
  src/misc is a zero-edit operation here, and the consumer just declares its
  <PackageReference> as normal. Non-Flowthru PackageReferences resolve to
  non-existent candidate paths and pass through unchanged.

  The prefixed-Identity variant exists for packages whose published id is the
  bare name but whose source directory carries the "Flowthru." prefix — e.g.,
  <PackageReference Include="FUnit"> resolves to
  src/core/Flowthru.FUnit/Flowthru.FUnit.csproj, which sets
  <PackageId>FUnit</PackageId>. Without this, the lookup would silently miss
  and NuGet would later trip on the literal "FlowthruVersion" placeholder.

  Fail-fast guard: a Flowthru-namespace PackageReference inside this monorepo
  always carries the literal Version="FlowthruVersion" (the dotnet template
  engine substitutes it during template instantiation; in-repo we expect the
  swap to remove the PackageReference before NuGet sees it). If a candidate
  still carries that placeholder after resolution, the in-repo lookup missed
  and we error out with a clear, Flowthru-specific message instead of letting
  NuGet emit "'FlowthruVersion' is not a valid version string" pointing at a
  line in NuGet.targets.

  Why it works at evaluation time (where I previously thought it was
  impossible):

    - Item batching with %(Identity) in metadata VALUES (not Conditions)
      iterates per-item at evaluation time. `<X Update="@(X)" Path="...%(Identity)..." />`
      runs once per item with the right Identity substituted.
    - Same-item-type %(Meta) in Conditions on metadata elements is also
      allowed (the rejected pattern was cross-type metadata).
    - The Include/Exclude pair with WithMetadataValue() filters items by
      metadata without crossing item-type boundaries in a Condition.

    See https://learn.microsoft.com/en-us/visualstudio/msbuild/msbuild-items
    (the "Updating metadata on items in an ItemGroup outside of a Target"
    section).

  IMPORTANT: All work happens in evaluation-time ItemGroups (NOT in a Target).
  Static project-graph analyzers — @nx/dotnet, MSBuild's ProjectGraph, IDEs —
  read items at evaluation time, so the resolved ProjectReferences MUST be
  visible there for dependent csprojs to be scheduled for build correctly.
-->
<Project>

  <PropertyGroup>
    <FlowthruInRepoSwapImported>true</FlowthruInRepoSwapImported>
  </PropertyGroup>

  <ItemGroup>
    <_FlowthruCandidate Include="@(PackageReference)" />
  </ItemGroup>

  <ItemGroup>
    <_FlowthruCandidate Update="@(_FlowthruCandidate)">
      <CoreCsproj>$(RepoRoot)src/core/%(Identity)/%(Identity).csproj</CoreCsproj>
      <ExtensionsCsproj>$(RepoRoot)src/extensions/%(Identity)/%(Identity).csproj</ExtensionsCsproj>
      <MiscCsproj>$(RepoRoot)src/misc/%(Identity)/%(Identity).csproj</MiscCsproj>
      <CorePrefixedCsproj>$(RepoRoot)src/core/Flowthru.%(Identity)/Flowthru.%(Identity).csproj</CorePrefixedCsproj>
      <ExtensionsPrefixedCsproj>$(RepoRoot)src/extensions/Flowthru.%(Identity)/Flowthru.%(Identity).csproj</ExtensionsPrefixedCsproj>
      <MiscPrefixedCsproj>$(RepoRoot)src/misc/Flowthru.%(Identity)/Flowthru.%(Identity).csproj</MiscPrefixedCsproj>
    </_FlowthruCandidate>
  </ItemGroup>

  <ItemGroup>
    <_FlowthruCandidate Update="@(_FlowthruCandidate)">
      <ResolvedPath Condition="Exists('%(CoreCsproj)')">%(CoreCsproj)</ResolvedPath>
      <ResolvedPath Condition="Exists('%(ExtensionsCsproj)')">%(ExtensionsCsproj)</ResolvedPath>
      <ResolvedPath Condition="Exists('%(MiscCsproj)')">%(MiscCsproj)</ResolvedPath>
      <ResolvedPath Condition="Exists('%(CorePrefixedCsproj)')">%(CorePrefixedCsproj)</ResolvedPath>
      <ResolvedPath Condition="Exists('%(ExtensionsPrefixedCsproj)')">%(ExtensionsPrefixedCsproj)</ResolvedPath>
      <ResolvedPath Condition="Exists('%(MiscPrefixedCsproj)')">%(MiscPrefixedCsproj)</ResolvedPath>
    </_FlowthruCandidate>
  </ItemGroup>

  <ItemGroup>
    <_FlowthruResolvedPath Include="@(_FlowthruCandidate->'%(ResolvedPath)')"
                           Exclude="@(_FlowthruCandidate->WithMetadataValue('ResolvedPath','')->'%(ResolvedPath)')" />

    <_FlowthruResolvedIdentity Include="@(_FlowthruCandidate->'%(Identity)')"
                               Exclude="@(_FlowthruCandidate->WithMetadataValue('ResolvedPath','')->'%(Identity)')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Remove="@(_FlowthruResolvedIdentity)" />
    <ProjectReference Include="@(_FlowthruResolvedPath)" />
  </ItemGroup>

  <ItemGroup>
    <_FlowthruUnresolvedPlaceholder Include="@(_FlowthruCandidate->WithMetadataValue('Version','FlowthruVersion')->WithMetadataValue('ResolvedPath',''))" />
  </ItemGroup>

  <Target Name="_FlowthruInRepoSwap_FailFast"
          BeforeTargets="_GenerateRestoreGraphProjectEntry;CollectPackageReferences;BeforeBuild">
    <Error Condition="'@(_FlowthruUnresolvedPlaceholder)' != ''"
           Text="Flowthru in-repo swap could not resolve PackageReference(s) [@(_FlowthruUnresolvedPlaceholder, ', ')] in $(MSBuildProjectFile). Searched src/core, src/extensions, src/misc (with and without 'Flowthru.' prefix). The package was likely renamed or removed in this monorepo — check src/ for the current name, update the PackageReference, or drop the placeholder Version=&quot;FlowthruVersion&quot; if this is meant to resolve from the published NuGet feed." />
  </Target>

  <!--
    Auto-wire analyzers for any Flowthru package the consumer references.
    Each per-package build/<Name>.targets file owns adding its own SG / CodeFix
    ProjectReferences to the consumer, gated against the package itself
    (the targets file no-ops when MSBuildProjectName equals its own owner).

    Core is unconditional because [FlowthruSchema] and the schema-marker
    interface generator are foundational — any Flowthru consumer that
    references Flowthru, Flowthru.Core, or any extension transitively
    needs Core's source-generator running. Keeping this unconditional
    matches the prior behavior and avoids surprising "your record didn't
    get marker interfaces" failures.

    FUnit and Python carry heavier analyzers (and force their SG csproj to
    build as a side-effect of being a ProjectReference), so they only fire
    when the consumer directly references the corresponding package. The
    marker ItemGroups filter @(_FlowthruResolvedIdentity) — populated above —
    by exact Identity match so this stays a pure-evaluation-time decision.
  -->
  <Import Project="$(RepoRoot)src/core/Flowthru.Core/build/Flowthru.Core.targets"
          Condition="Exists('$(RepoRoot)src/core/Flowthru.Core/build/Flowthru.Core.targets')" />

  <!--
    Item-list references aren't allowed in Import conditions, so materialize a
    delimited string of resolved Flowthru.* identities into a property and
    substring-match against it. The leading/trailing ';' guard against
    Flowthru.FUnit accidentally matching a hypothetical Flowthru.FUnitX.
  -->
  <PropertyGroup>
    <_FlowthruResolvedIdentities>;@(_FlowthruResolvedIdentity);</_FlowthruResolvedIdentities>
    <_FlowthruHasFUnit Condition="$(_FlowthruResolvedIdentities.Contains(';Flowthru.FUnit;'))">true</_FlowthruHasFUnit>
    <_FlowthruHasPython Condition="$(_FlowthruResolvedIdentities.Contains(';Flowthru.Extensions.Python;'))">true</_FlowthruHasPython>
  </PropertyGroup>

  <Import Project="$(RepoRoot)src/core/Flowthru.FUnit/build/Flowthru.FUnit.targets"
          Condition="'$(_FlowthruHasFUnit)' == 'true' AND Exists('$(RepoRoot)src/core/Flowthru.FUnit/build/Flowthru.FUnit.targets')" />

  <Import Project="$(RepoRoot)src/extensions/Flowthru.Extensions.Python/build/Flowthru.Extensions.Python.targets"
          Condition="'$(_FlowthruHasPython)' == 'true' AND Exists('$(RepoRoot)src/extensions/Flowthru.Extensions.Python/build/Flowthru.Extensions.Python.targets')" />

</Project>
