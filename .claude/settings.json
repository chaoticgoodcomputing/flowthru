{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agents/hooks/on-start/load-contributing.js",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node scripts/agents/hooks/on-start/load-agent-skills.js",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node scripts/agents/hooks/on-start/load-examples-contributing.js",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agents/hooks/on-stop/check.js",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node scripts/agents/hooks/on-stop/test-update-check.js",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "HOOK_TIMEOUT_SEC=300 node scripts/agents/hooks/on-stop/test-affected.js",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
